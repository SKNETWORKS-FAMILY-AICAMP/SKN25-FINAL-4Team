# ── Database (PostgreSQL + TimescaleDB) ──────────────────────────────
# NAS 또는 팀 서버 접속 정보로 교체하세요
DB_HOST=YOUR_DB_HOST
DB_PORT=5432
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=YOUR_DB_NAME
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME

# ── LLM 프로바이더 선택 ───────────────────────────────────────────────
# LLM_PROVIDER: openai | anthropic | gemini | ollama
# LLM_MODEL/REPORT_LLM_MODEL: 보고서·품질 경로 모델
# LLM_MODEL_FAST/CHATBOT_LLM_MODEL: 챗봇·속도 경로 모델
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:12b
LLM_MODEL_FAST=exaone3.5:7.8b
REPORT_LLM_MODEL=gemma4:12b
CHATBOT_LLM_MODEL=exaone3.5:7.8b
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=2
OLLAMA_KEEP_ALIVE=30m

# ── API 키 (사용하는 프로바이더 키만 입력하면 됩니다) ─────────────────
# OpenAI   → https://platform.openai.com/api-keys
#   모델 예시: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_API_KEY=

# Anthropic → https://console.anthropic.com
#   모델 예시: claude-opus-4-5, claude-sonnet-4-5, claude-haiku-4-5
ANTHROPIC_API_KEY=

# Google Gemini → https://aistudio.google.com/app/apikey
#   모델 예시: gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash
GEMINI_API_KEY=

# ── 일일 보고서 자동 생성 스케줄러 ───────────────────────────────────
# 매일 정해진 시각에 '가장 최근 데이터 날짜'의 일일 보고서를 자동 생성합니다.
# (과거 이력 데이터에서는 마지막 날짜 기준, 실시간 데이터 유입 시 '어제' 기준으로 동작)
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR=6
DAILY_REPORT_MINUTE=0
