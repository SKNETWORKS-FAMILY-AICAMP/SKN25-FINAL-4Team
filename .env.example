# ── Database (PostgreSQL + TimescaleDB) ──────────────────────────────
# NAS 또는 팀 서버 접속 정보로 교체하세요
DB_HOST=YOUR_DB_HOST
DB_PORT=5432
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=YOUR_DB_NAME
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME

# ── LLM 프로바이더 선택 ───────────────────────────────────────────────
# LLM_PROVIDER: openai | anthropic | gemini
# LLM_MODEL   : 사용할 모델명 (프로바이더별 예시 아래 참고)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# ── API 키 (사용하는 프로바이더 키만 입력하면 됩니다) ─────────────────
# OpenAI   → https://platform.openai.com/api-keys
#   모델 예시: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_API_KEY=

# Anthropic → https://console.anthropic.com
#   모델 예시: claude-opus-4-5, claude-sonnet-4-5, claude-haiku-4-5
ANTHROPIC_API_KEY=

# Google Gemini → https://aistudio.google.com/app/apikey
#   모델 예시: gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash
GEMINI_API_KEY=
