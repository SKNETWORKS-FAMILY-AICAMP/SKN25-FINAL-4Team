@prefix energy: <http://honda-energy.skn.kr/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

energy:CHPOutage a energy:AnomalyType ;
    rdfs:label "CHP 정지 이상"@ko ;
    energy:affects energy:GridDependency,
        energy:SelfSufficiency ;
    rdfs:comment "CHP 전기·열 동시 0. 자급률 급감, 그리드 의존도 증가."@ko .

energy:CHPSystem a owl:Class ;
    rdfs:label "열병합 발전 — 전기(electricity_P.CHP)와 열(heating_P.CHP_heat) 동시 생산"@ko ;
    energy:derivesKPI energy:SelfSufficiency ;
    energy:produces energy:ElectricalSystem,
        energy:HeatingSystem ;
    rdfs:subClassOf energy:EnergySource .

energy:COPDrop a energy:AnomalyType ;
    rdfs:label "COP 급락 이상"@ko ;
    energy:affects energy:COP,
        energy:CoolingSystem ;
    rdfs:comment "냉방 효율 저하. 냉각기 과부하 또는 냉매 부족 의심."@ko .

energy:CoolingMeter a owl:Class ;
    rdfs:label "냉방 계측기 (URN 접두 K — Kühlung). H1·H2·V 구역에 설치"@ko ;
    energy:locatedIn energy:ZoneH1,
        energy:ZoneH2,
        energy:ZoneV ;
    energy:measuredBy energy:CoolingSystem ;
    rdfs:subClassOf energy:Meter .

energy:ElectricalMeter a owl:Class ;
    rdfs:label "전기 계측기 (URN 접두 Z·ZE). 각 구역 전력 소비 측정"@ko ;
    energy:locatedIn energy:ZoneH1,
        energy:ZoneH2,
        energy:ZoneH3,
        energy:ZoneH4,
        energy:ZoneV ;
    energy:measuredBy energy:ElectricalSystem ;
    rdfs:subClassOf energy:Meter .

energy:GridConnection a owl:Class ;
    rdfs:label "외부 계통 전력 — 독일 공공 전력망 (electricity_P.total)"@ko ;
    energy:derivesKPI energy:GridDependency,
        energy:SelfSufficiency ;
    energy:produces energy:ElectricalSystem ;
    rdfs:subClassOf energy:EnergySource .

energy:NightConsumption a energy:AnomalyType ;
    rdfs:label "야간 이상 소비"@ko ;
    energy:affects energy:ElectricalSystem ;
    rdfs:comment "운영 시간 외 전력 소비. 설비 미차단 또는 침입 의심."@ko .

energy:PVNightNonZero a energy:AnomalyType ;
    rdfs:label "PV 야간 비정상"@ko ;
    energy:affects energy:PVSystem ;
    rdfs:comment "야간 PV > 0은 센서 오류. 정상 야간 NaN과 구별 필요."@ko .

energy:PowerSpike a energy:AnomalyType ;
    rdfs:label "전력 급등 이상"@ko ;
    energy:affects energy:ElectricalSystem ;
    rdfs:comment "electricity_P.total 급증. 그리드 과부하 위험."@ko .

energy:ThermalMeter a owl:Class ;
    rdfs:label "열량 계측기 (URN 접두 W — Wärme). H1.W11·W12만 존재. H2.T.Z* 는 전기 미터(ABB-B24)이므로 혼동 주의"@ko ;
    energy:locatedIn energy:ZoneH1 ;
    energy:measuredBy energy:HeatingSystem ;
    rdfs:subClassOf energy:Meter .

energy:WeatherStationZone a energy:BuildingZone ;
    rdfs:label "기상 관측소"@ko ;
    energy:affects energy:AmbientTemp,
        energy:SolarIrradiance ;
    rdfs:comment "Rooftop Weather Station. Lufft WS501-UMB. 시설 최고점(옥상) 설치. 일사량(Igm, W/m²)·외기온(Ta, °C) 측정. 위치: 50.0848°N, 8.8401°E. PV 발전량 예측·냉방 부하 분석에 활용."@ko .

energy:affects a owl:ObjectProperty ;
    rdfs:label "영향을 준다"@ko .

energy:aggregatesZone a owl:ObjectProperty ;
    rdfs:label "구역 데이터를 집계한다"@ko .

energy:consumes a owl:ObjectProperty ;
    rdfs:label "에너지를 소비한다"@ko .

energy:derivesKPI a owl:ObjectProperty ;
    rdfs:label "KPI를 산출한다"@ko .

energy:locatedIn a owl:ObjectProperty ;
    rdfs:label "구역에 위치한다"@ko .

energy:measuredBy a owl:ObjectProperty ;
    rdfs:label "계측기로 측정된다"@ko .

energy:produces a owl:ObjectProperty ;
    rdfs:label "에너지를 생산한다"@ko .

energy:AmbientTemp a energy:WeatherFactor ;
    rdfs:label "외기온 (Ta)"@ko ;
    energy:affects energy:CoolingSystem,
        energy:HeatingSystem ;
    rdfs:comment "냉방 부하 및 COP에 영향. weather.csv.gz의 Ta 컬럼 (°C)."@ko .

energy:SolarIrradiance a energy:WeatherFactor ;
    rdfs:label "일사량 (Igm)"@ko ;
    energy:affects energy:PVSystem ;
    rdfs:comment "PV 발전량에 직접 영향. weather.csv.gz의 Igm 컬럼 (W/m²)."@ko .

energy:ZoneH3 a energy:BuildingZone ;
    rdfs:label "H3 디자인 스튜디오"@ko ;
    energy:consumes energy:ElectricalSystem ;
    rdfs:comment "Design Studio. 자동차 디자인 스튜디오, 주행 시뮬레이터(일반·제어·HVAC), 서버실 O4. 배전(Z40·ZE40: 배전 1, Z41·ZE41: 배전 4 — 각각 주/백업 2023년 교정법 쌍), 서버(Z43·ZE43: O4 냉각 1, Z44·ZE44: O4 냉각 2, Z46: O4 전원, Z71: O4 전원 추가), 환기(Z42: 디자인 스튜디오), 냉각(Z45: 디자인 스튜디오 냉각), 시뮬레이터(Z47: 일반, Z48: 제어, Z49: HVAC), PV(H3.Z312: 디자인 스튜디오 지붕, 그룹 3&4 23.4% + 그룹 5&6 ≈ 193kWp, 평균 -20.6kW). ZE40·ZE41·ZE43·ZE44는 PV가 아닌 배전/서버 백업 미터(2023년 교정법). 열량·냉수 미터 없음 — 전기만 계측."@ko .

energy:ZoneH4 a energy:BuildingZone ;
    rdfs:label "H4 사무동 B4"@ko ;
    energy:consumes energy:ElectricalSystem ;
    rdfs:comment "Office Building B4. 사무 공간. 배전(H4.Z50·ZE50: 사무동 B4 배전 3, H4.Z51·ZE51: 사무동 B4 배전 4) 4개 미터. ZE50·ZE51은 PV가 아닌 배전 백업 미터(2023년 교정법). 소규모 구역 — 열량·냉수 미터 없음."@ko .

energy:COP a energy:KPI ;
    rdfs:label "성능계수 (COP)"@ko ;
    energy:formula "cooling_output / cooling_elec" ;
    rdfs:comment "cooling_P.total / cooling_P.cool_elec. 중앙값 2.06. cool_elec=0 시 0나누기 방어 필수."@ko .

energy:GridDependency a energy:KPI ;
    rdfs:label "그리드 의존도"@ko ;
    energy:formula "grid / (grid + PV + CHP)" ;
    rdfs:comment "grid / total_consumption. 자급률의 반대 개념."@ko .

energy:PVSystem a owl:Class ;
    rdfs:label "태양광 발전 (electricity_P.PV)"@ko ;
    energy:derivesKPI energy:SelfSufficiency ;
    energy:produces energy:ElectricalSystem ;
    rdfs:subClassOf energy:EnergySource .

energy:WeatherFactor a owl:Class ;
    rdfs:label "날씨 영향 요인"@ko .

energy:ZoneH2 a energy:BuildingZone ;
    rdfs:label "H2 워크숍·서버실"@ko ;
    energy:consumes energy:CoolingSystem,
        energy:ElectricalSystem ;
    rdfs:comment "Workshop & Server Room. 자동차 부품 워크숍, CIS·EU 서버실, Robolab. 냉방(H2.K21: 사무실 HVAC), 배전(H2.T.Z30: 사무동 B2 전체, H2.T.Z31: HVAC 50/51 환기, H2.T.Z32: 로비, H2.T.Z33: 디자인 스튜디오 급전, H2.T.Z34: 워크숍 급전) — T.Z* 미터는 모두 ABB-B24 전기 미터임. 전기(Z61·Z62·Z63: CIS 서버 냉각·전원, Z64·Z65: EU 서버 전원, Z66·Z67: 로컬 냉각 스플릿 AC, Z68·Z69·Z70: 환기 시스템 17/16/18, ZE74: Robolab), PV(H2.Z311: 사무동 옥상, 그룹 3&4의 57.8% ≈ 317kWp, 평균 -33.9kW). ZE64·ZE65·ZE66·ZE67은 PV가 아닌 서버/냉각 백업 미터(2023년 교정법). 열량 미터 없음 — H2에는 W-계열(난방) 미터가 설치되지 않음."@ko .

energy:ZoneV a energy:BuildingZone ;
    rdfs:label "V 부지 공통"@ko ;
    energy:consumes energy:ElectricalSystem ;
    rdfs:comment "Site-wide. 외부 계통 연결 변압기(V.Z81·V.Z82: 주차장 변압기 1·2, 20kV→230V 2권선), PV 주차장(V.Z84: 그룹 1&2 ≈ 136kWp, 평균 -14.6kW; V.ZE84: 2023년 교정법 백업 미터), 중앙 냉각기 총합(V.K21: CM1+CM2+CM3 열량, 평균 54kW, Tvl=6.5°C). 시설 전체 PV 총 용량 749kWp, 연평균 자급률 6년평균 39.6%(2022년 46.9%)."@ko .

energy:EnergySource a owl:Class ;
    rdfs:label "에너지 공급원 (그리드, PV, CHP)"@ko .

energy:EnergySystem a owl:Class ;
    rdfs:label "건물 에너지 시스템 (전기, 냉방, 난방)"@ko .

energy:KPI a owl:Class ;
    rdfs:label "핵심 성과 지표"@ko .

energy:Meter a owl:Class ;
    rdfs:label "에너지 계측기 (전력계, 열량계)"@ko .

energy:ZoneH1 a energy:BuildingZone ;
    rdfs:label "H1 배기가스 시험실"@ko ;
    energy:consumes energy:CoolingSystem,
        energy:ElectricalSystem,
        energy:HeatingSystem ;
    rdfs:comment "Emission Lab. 차량 배기가스 시험(롤러 시험대·테스트 챔버), HVAC 테스트 벤치. 냉방(K11~K16: CM1·CM2·CM3 및 서버실 O1), 열량(W11·W12: CHP·보일러 총 열량), 전기 29개 미터. PV(H1.Z310: Emission Lab 지붕). CHP 생산 미터(H1.ZE20). 시설 내 에너지 소비 최대 구역."@ko .

energy:HeatingSystem a owl:Class ;
    rdfs:label "난방 시스템 (heating_P / heating_W)"@ko ;
    rdfs:subClassOf energy:EnergySystem .

energy:SelfSufficiency a energy:KPI ;
    rdfs:label "자급률"@ko ;
    energy:formula "(PV + CHP) / (grid + PV + CHP)" ;
    rdfs:comment "(PV + CHP) / total_consumption. 이 시설 6년평균 39.6%(2022년 46.9%). 높을수록 그리드 의존도 낮음."@ko .

energy:AnomalyType a owl:Class ;
    rdfs:label "이상 유형"@ko .

energy:CoolingSystem a owl:Class ;
    rdfs:label "냉방 시스템 (cooling_P / cooling_W)"@ko ;
    energy:consumes energy:ElectricalSystem ;
    energy:derivesKPI energy:COP ;
    rdfs:subClassOf energy:EnergySystem .

energy:BuildingZone a owl:Class ;
    rdfs:label "건물 구역 (Honda R&D Offenbach 내 구역)"@ko .

energy:ElectricalSystem a owl:Class ;
    rdfs:label "전기 시스템 (electricity_P / electricity_W)"@ko ;
    rdfs:subClassOf energy:EnergySystem .

