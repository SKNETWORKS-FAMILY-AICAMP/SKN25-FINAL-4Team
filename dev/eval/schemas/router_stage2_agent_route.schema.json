{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/router-stage2-agent-route-260612.schema.json",
  "title": "Stage 2 Router Route Dataset",
  "description": "Schema for two-stage router Stage 2 dataset used in test06_stage2 / test09_two_stage",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/definitions/sample"
  },
  "definitions": {
    "sample": {
      "type": "object",
      "required": [
        "id",
        "message",
        "expected_route",
        "difficulty",
        "style",
        "source",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S2-(ANOMALY|CMS|FORECAST|REPORT|RAG)-\\d{3}$"
        },
        "message": {
          "type": "string",
          "minLength": 8
        },
        "expected_route": {
          "type": "string",
          "enum": ["anomaly", "cms", "forecast", "report", "rag"]
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"]
        },
        "style": {
          "type": "string",
          "enum": [
            "direct",
            "colloquial",
            "short",
            "polite",
            "ambiguous",
            "ops_console",
            "report_like",
            "mixed_korean_english"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
