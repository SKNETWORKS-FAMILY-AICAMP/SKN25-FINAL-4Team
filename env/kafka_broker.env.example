# Local Kafka broker env template for PC1~3.
# Copy this file to docker/local_kafka_broker.env on each local computer.
# Use one shared KAFKA_CLUSTER_ID across all three brokers.
# Set KAFKA_NODE_ID and KAFKA_ADVERTISED_HOST differently on each host:
#   PC1: KAFKA_NODE_ID=1, KAFKA_ADVERTISED_HOST=192.168.0.36
#   PC2: KAFKA_NODE_ID=2, KAFKA_ADVERTISED_HOST=192.168.0.212
#   PC3: KAFKA_NODE_ID=3, KAFKA_ADVERTISED_HOST=192.168.0.217
# Bind 9092/9093 only on a trusted LAN/VPN segment, not the public internet.

KAFKA_CLUSTER_ID=x4f0AU3xSAGjFZuInrE4cg
KAFKA_NODE_ID=1
KAFKA_ADVERTISED_HOST=192.168.0.36
KAFKA_CONTROLLER_QUORUM_VOTERS=1@192.168.0.36:9093,2@192.168.0.212:9093,3@192.168.0.217:9093
KAFKA_BIND=0.0.0.0
KAFKA_CONTROLLER_BIND=0.0.0.0

KAFKA_LOG_RETENTION_HOURS=24
KAFKA_LOG_RETENTION_BYTES=1073741824
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=2
KAFKA_DEFAULT_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
