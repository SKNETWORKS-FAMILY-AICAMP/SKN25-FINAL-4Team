# Local PC1 stream env template for PC1~3 Kafka + reachable AWS cms-db.
# Copy to docker/local_stream.env on PC1 and fill secrets there only.
# Use with: docker compose --env-file docker/local_stream.env -f docker/compose.local.stream.yml up -d cms-ingestion-api
# Gate C1 should start only cms-ingestion-api against the existing PC1~3 Kafka cluster.
# Run docker/compose.local.kafka-broker.yml on PC2/PC3 with matching cluster settings.
# Gzip source replay is authoritative on PC1 only; do not run source replay on PC2/PC3.

# Required only for backend/db-writer profiles: set to the AWS cms-db endpoint
# reachable from PC1. Leave blank for Gate C1 ingestion-only smoke.
CMS_RUNTIME_PROFILE=local
PC1_LIVE_SOURCE_ROOT=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=cms
POSTGRES_USER=cms_ingest
POSTGRES_READONLY_USER=cms_ingest
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

KAFKA_CLUSTER_ID=x4f0AU3xSAGjFZuInrE4cg
KAFKA_NODE_ID=1
KAFKA_ADVERTISED_HOST=192.168.0.36
KAFKA_CONTROLLER_QUORUM_VOTERS=1@192.168.0.36:9093,2@192.168.0.212:9093,3@192.168.0.217:9093
KAFKA_BROKER_1=192.168.0.36:9092
KAFKA_BROKER_2=192.168.0.212:9092
KAFKA_BROKER_3=192.168.0.217:9092
KAFKA_BOOTSTRAP_SERVERS=192.168.0.36:9092,192.168.0.212:9092,192.168.0.217:9092
KAFKA_RAW_REPLICATION_FACTOR=2
KAFKA_DLQ_REPLICATION_FACTOR=2
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=2
KAFKA_DEFAULT_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
MEASUREMENT_RAW_TOPIC=measurement_raw_v1
MEASUREMENT_DLQ_TOPIC=measurement_dead_letter_v1
KAFKA_CONSUMER_GROUP=postgres-live-ingest

CMS_INGESTION_API_BIND=127.0.0.1
CMS_INGESTION_API_PORT=8000
CMS_BACKEND_API_BIND=127.0.0.1
CMS_BACKEND_API_PORT=8001
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_CONFIG_PATH=./prometheus/local_pc123.yml

ALLOW_CANONICAL_WRITE=0
ALLOW_PRODUCTION_DDL=0
CMS_ENABLE_RUNTIME_KAFKA_PRODUCER=1
CMS_ENABLE_RUNTIME_CONSUMER=0
# Gate D1 real DB write requires both:
# CMS_ENABLE_RUNTIME_CONSUMER=1
# CMS_CONSUMER_COMMAND=python scripts/live/run_consumer_service.py --runtime
CMS_CONSUMER_COMMAND=python scripts/live/run_consumer_service.py

# Optional observability placeholders for local Grafana/provisioning consumers.
GRAFANA_POSTGRES_HOST=
GRAFANA_POSTGRES_PORT=5432
GRAFANA_POSTGRES_DB=cms
GRAFANA_POSTGRES_USER=cms_ingest
GRAFANA_POSTGRES_PASSWORD=
GRAFANA_POSTGRES_SSLMODE=disable
GRAFANA_PROMETHEUS_URL=http://localhost:9090
