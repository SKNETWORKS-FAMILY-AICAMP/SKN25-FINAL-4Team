# RunPod anomaly worker
MODEL_ARTIFACT_UPLOAD_URL=
ARTIFACT_UPLOAD_TOKEN=

# Allowed PC3/cloudflared hosts, comma-separated if multiple
RUNPOD_ALLOWED_UPLOAD_HOSTS=
RUNPOD_ALLOWED_DATA_HOSTS=

# Optional separate token for training-data download
TRAINING_DATA_TOKEN=

# Runtime limits
RUNPOD_TRAIN_TIMEOUT_SECONDS=86400
RUNPOD_UPLOAD_RETRIES=3
RUNPOD_UPLOAD_TIMEOUT_SECONDS=300
RUNPOD_DATA_DOWNLOAD_TIMEOUT_SECONDS=600
