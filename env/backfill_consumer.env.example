# Host-local template for the throttled backfill Kafka -> PostgreSQL consumer lane.
# Copy to a non-committed env file only after the backfill topic/producer policy is approved.

CMS_RUNTIME_PROFILE=edge
CMS_CONSUMER_CONTAINER_NAME=cms-backfill-consumer-pc1
KAFKA_CONSUMER_CLIENT_ID=pc1-postgres-backfill-ingest
KAFKA_CONSUMER_INSTANCE_ID=pc1-postgres-backfill-ingest

KAFKA_BOOTSTRAP_SERVERS=host1:9092,host2:9092,host3:9092

# Backfill lane. Do not point the live dashboard at this topic/group.
MEASUREMENT_RAW_TOPIC=measurement_backfill_v1
KAFKA_TOPIC_IDENTITY=local_pc123.measurement_backfill_v1
KAFKA_CONSUMER_GROUP=postgres-backfill-ingest
KAFKA_AUTO_OFFSET_RESET=earliest

MEASUREMENT_DLQ_TOPIC=measurement_dead_letter_v1
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_MAX_POLL_INTERVAL_MS=300000

# Throttling is enforced by the backfill producer/runner policy, not this template.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=cms
POSTGRES_USER=cms_ingest
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

ALLOW_CANONICAL_WRITE=0
ALLOW_PRODUCTION_DDL=0
