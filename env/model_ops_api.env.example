# PC3 model-ops API
MODEL_OPS_TOKEN=
ARTIFACT_UPLOAD_TOKEN=
RUNPOD_ENDPOINT_ID=
RUNPOD_ANOMALY_ENDPOINT_ID=
RUNPOD_PMAX_ENDPOINT_ID=
RUNPOD_API_KEY=
RUNPOD_ARTIFACT_UPLOAD_URL=
RUNPOD_ANOMALY_ARTIFACT_UPLOAD_URL=
RUNPOD_PMAX_ARTIFACT_UPLOAD_URL=
RUNPOD_TRAINING_DATA_BASE_URL=
RUNPOD_ANOMALY_TRAINING_DATA_BASE_URL=
RUNPOD_PMAX_TRAINING_DATA_BASE_URL=

# Model-ops feature gates
CMS_MODEL_OPS_ENABLE_RUNPOD=1
CMS_MODEL_OPS_ENABLE_STATE_WRITES=1
CMS_MODEL_OPS_ENABLE_ARTIFACT_WRITES=1
CMS_MODEL_OPS_ENABLE_PROMOTION_WRITES=0

# Artifact limits
MAX_ARTIFACT_UPLOAD_MB=2048
KEEP_UPLOADED_ARCHIVES=0

# Optional anomaly artifact paths
ANOMALY_ARTIFACTS_DIR=
ANOMALY_CANDIDATES_ROOT=
ANOMALY_ARCHIVES_ROOT=
ANOMALY_TRAINING_DATA_ROOT=

# Optional P-Max artifact paths
IMPORT_PMAX_ARTIFACTS_DIR=
IMPORT_PMAX_CANDIDATES_ROOT=
IMPORT_PMAX_ARCHIVES_ROOT=
IMPORT_PMAX_TRAINING_DATA_ROOT=
