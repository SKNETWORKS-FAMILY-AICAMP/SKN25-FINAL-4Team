# Model-serving runtime env template.
# Copy to docker/model_serving.env on the runtime host and fill secrets there only.

MODEL_SERVING_BASE_TS=2026-06-09T03:00:00+00:00
MODEL_SERVING_ARTIFACT_ROOT=../../artifacts/external
PMAX_ARTIFACT_ROOT=/artifacts/pmax
ANOMALY_ARTIFACT_ROOT=/artifacts/anomaly
# Optional: point at a generated predictions_*.csv or JSON. Empty keeps anomaly
# inference disabled for no-write P-Max smoke while artifacts are validated by
# cms-artifact-smoke.
ANOMALY_PREDICTIONS_PATH=
CMS_ANOMALY_SOURCE_TABLE=mart.anomaly_feature_1h
CMS_ANOMALY_SOURCE_TS_COLUMN=bucket_ts

POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=cms
POSTGRES_USER=cms_ingest
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

ALLOW_MODEL_SERVING_WRITE=0
ALLOW_NONPROD_WARM_START_MODEL_SERVING_WRITE=0
CMS_ENABLE_CANONICAL_PROMOTION=0
CMS_ENABLE_ANOMALY_FEATURE_MATERIALIZATION=0
CMS_CANONICAL_PROMOTION_ID=service_continuous_canonical
CMS_CANONICAL_APPROVAL_ID=service_continuous_approval
CMS_OPERATIONAL_SCHEDULER_INTERVAL_SECONDS=300
CMS_MODEL_SERVING_INTERVAL_SECONDS=900
CMS_LIVE_WORKER_INTERVAL_SECONDS=30
CMS_LIVE_MEAN_ROLLUP_BATCH_SIZE=100
CMS_PEAK_FEATURE_BATCH_SIZE=100

# Hybrid warm-start policy: model serving no longer uses replay-clock env vars.
# The scheduler bridges reference.corrected_resampled_* history before
# 2023-12-01T00:00:00+00:00 and prefers live_observed mart rows once present.
