# Host-local template for docker/compose_distributed_consumer.yml.
# Copy to docker/distributed_consumer.env on EACH PC and fill values locally.
# Do not commit real passwords, tokens, private hostnames, or copied .env files.
#
# Target topology:
#   PC1: CMS_CONSUMER_INSTANCE_ID=pc1-postgres-live-ingest
#   PC2: CMS_CONSUMER_INSTANCE_ID=pc2-postgres-live-ingest
#   PC3: CMS_CONSUMER_INSTANCE_ID=pc3-postgres-live-ingest
# All three use the same KAFKA_CONSUMER_GROUP=postgres-live-ingest.

CMS_RUNTIME_PROFILE=edge
CMS_CONSUMER_CONTAINER_NAME=cms-kafka-consumer-pc1
KAFKA_CONSUMER_CLIENT_ID=pc1-postgres-live-ingest
KAFKA_CONSUMER_INSTANCE_ID=pc1-postgres-live-ingest

KAFKA_BROKER_1=host1:9092
KAFKA_BROKER_2=host2:9092
KAFKA_BROKER_3=host3:9092
KAFKA_BOOTSTRAP_SERVERS=host1:9092,host2:9092,host3:9092
MEASUREMENT_RAW_TOPIC=measurement_raw_v1
KAFKA_TOPIC_IDENTITY=local_pc123.measurement_raw_v1
MEASUREMENT_DLQ_TOPIC=measurement_dead_letter_v1
KAFKA_CONSUMER_GROUP=postgres-live-ingest
# Used only if the group has no committed offsets. Existing committed offsets are respected.
KAFKA_AUTO_OFFSET_RESET=latest
# Static membership reduces rebalance churn for one standing consumer per host.
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_MAX_POLL_INTERVAL_MS=300000
# Optional; set only after all members use a compatible assignment strategy.
# KAFKA_PARTITION_ASSIGNMENT_STRATEGY=cooperative-sticky

# PostgreSQL target. Use the routable AWS DB endpoint for PC1/PC2/PC3, not AWS private 172.31.x.x.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=cms
POSTGRES_USER=cms_ingest
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

ALLOW_CANONICAL_WRITE=0
ALLOW_PRODUCTION_DDL=0
