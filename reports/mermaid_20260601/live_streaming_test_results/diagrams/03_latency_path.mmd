flowchart TB
    classDef source fill:#f8fafc,stroke:#64748b,stroke-width:1.4px,color:#0f172a,font-size:15px;
    classDef buffer fill:#eef2ff,stroke:#6366f1,stroke-width:1.4px,color:#111827,font-size:15px;
    classDef worker fill:#ecfdf5,stroke:#059669,stroke-width:1.4px,color:#064e3b,font-size:15px;
    classDef qa fill:#fff7ed,stroke:#ea580c,stroke-width:1.4px,color:#7c2d12,font-size:15px;
    classDef ops fill:#fdf2f8,stroke:#db2777,stroke-width:1.4px,color:#831843,font-size:15px;
    classDef canon fill:#f0f9ff,stroke:#0284c7,stroke-width:1.6px,color:#0c4a6e,font-size:15px;
    classDef service fill:#f5f3ff,stroke:#7c3aed,stroke-width:1.4px,color:#4c1d95,font-size:15px;
    classDef hold fill:#f8fafc,stroke:#94a3b8,stroke-dasharray:5 4,color:#475569,font-size:15px;

    live["<b>live event received</b><br/>target p95 50-200 ms"]:::source
    raw["<b>MongoDB raw write</b><br/>measurement_raw<br/>target p95 50-200 ms"]:::buffer
    poll["<b>processor poll</b><br/>cursor and watermark<br/>idempotent read"]:::worker
    equalize["<b>interval update</b><br/>1min candidate<br/>15min and 1h rollup"]:::worker
    qa["<b>light QA check</b><br/>schema, range, duplicate<br/>coverage state"]:::qa
    preview["<b>preview available</b><br/>candidate or cache<br/>target 0.5-5 s"]:::buffer
    ops["<b>ops and QA state</b><br/>counter, latency<br/>run evidence"]:::ops
    api["<b>read path</b><br/>FastAPI status<br/>dashboard cache"]:::service

    live --> raw --> poll --> equalize --> qa --> preview --> ops --> api
    qa --> reject["<b>reject or quarantine</b><br/>bad timestamp<br/>bad value"]:::qa
    preview -.not SLA.-> promo["<b>canonical promotion</b><br/>separate approval SLA<br/>not live ingest latency"]:::hold
