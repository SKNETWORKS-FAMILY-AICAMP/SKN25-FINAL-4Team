flowchart TB
    classDef source fill:#f8fafc,stroke:#64748b,stroke-width:1.4px,color:#0f172a,font-size:15px;
    classDef buffer fill:#eef2ff,stroke:#6366f1,stroke-width:1.4px,color:#111827,font-size:15px;
    classDef worker fill:#ecfdf5,stroke:#059669,stroke-width:1.4px,color:#064e3b,font-size:15px;
    classDef qa fill:#fff7ed,stroke:#ea580c,stroke-width:1.4px,color:#7c2d12,font-size:15px;
    classDef ops fill:#fdf2f8,stroke:#db2777,stroke-width:1.4px,color:#831843,font-size:15px;
    classDef canon fill:#f0f9ff,stroke:#0284c7,stroke-width:1.6px,color:#0c4a6e,font-size:15px;
    classDef service fill:#f5f3ff,stroke:#7c3aed,stroke-width:1.4px,color:#4c1d95,font-size:15px;
    classDef hold fill:#f8fafc,stroke:#94a3b8,stroke-dasharray:5 4,color:#475569,font-size:15px;

    row["<b>candidate row</b><br/>value, timestamp<br/>lineage and resolution"]:::buffer
    schema["<b>schema and type check</b><br/>finite value<br/>valid timestamp"]:::qa
    source["<b>source coverage check</b><br/>missing source<br/>late or duplicate event"]:::qa
    reference["<b>reference comparison</b><br/>corrected_resampled<br/>divergence state"]:::qa
    mask["<b>model mask decision</b><br/>model_input_available<br/>mask_reason"]:::qa
    usable["<b>model-usable row</b><br/>eligible for dry-run<br/>not canonical fact"]:::service
    blocked["<b>blocked row</b><br/>quarantine or review<br/>excluded from model"]:::hold
    evidence["<b>QA evidence packet</b><br/>counts, reasons<br/>latency, lineage"]:::ops

    row --> schema --> source --> reference --> mask
    mask --> usable --> evidence
    mask --> blocked --> evidence
    evidence -.eligible only.-> request["<b>promotion request</b><br/>separate approval<br/>controlled path"]:::ops
