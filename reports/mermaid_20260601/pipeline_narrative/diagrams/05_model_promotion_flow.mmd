candidate["candidate output<br/>15min/1h rows plus mask"]:::buffer
    qa["candidate QA evidence<br/>coverage, divergence, latency"]:::qa
    feature["feature schema<br/>dtype, null policy, mask policy"]:::ops
    registry["model registry<br/>artifact URI, version, trained-on product"]:::ops
    infer["real inference dry-run<br/>blocked until artifact exists"]:::worker
    pred["prediction result<br/>success, masked, error rows"]:::service
    request["promotion request<br/>candidate run, QA result, rollback"]:::ops
    approval["approval review<br/>human or workflow-assisted"]:::ops
    controlled["controlled promotion role<br/>idempotent procedure only"]:::ops
    published["published serving/canonical target<br/>15min and 1h boundary"]:::canon
    monitor["monitoring and runbook<br/>latency, row count, drift, rollback"]:::service

    candidate --> qa --> request --> approval --> controlled --> published --> monitor
    candidate --> feature --> infer --> pred --> request
    registry --> infer
    approval -. optional review .-> pred
