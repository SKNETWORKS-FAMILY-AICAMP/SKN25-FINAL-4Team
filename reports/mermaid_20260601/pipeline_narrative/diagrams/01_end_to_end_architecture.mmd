%%{init: {"theme": "base", "flowchart": {"htmlLabels": true, "nodeSpacing": 58, "rankSpacing": 78, "curve": "basis", "padding": 16}, "themeVariables": {"background": "#ffffff", "primaryColor": "#f8fafc", "primaryBorderColor": "#64748b", "primaryTextColor": "#0f172a", "lineColor": "#475569", "edgeLabelBackground": "#ffffff", "fontFamily": "Arial, sans-serif", "fontSize": "15px", "clusterBkg": "#ffffff", "clusterBorder": "#cbd5e1"}} }%%
flowchart TB
    classDef source fill:#f8fafc,stroke:#64748b,stroke-width:1.4px,color:#0f172a,font-size:15px;
    classDef archive fill:#fff7ed,stroke:#ea580c,stroke-width:1.4px,color:#7c2d12,font-size:15px;
    classDef buffer fill:#eef2ff,stroke:#6366f1,stroke-width:1.4px,color:#312e81,font-size:15px;
    classDef worker fill:#ecfdf5,stroke:#059669,stroke-width:1.4px,color:#064e3b,font-size:15px;
    classDef qa fill:#fefce8,stroke:#ca8a04,stroke-width:1.4px,color:#713f12,font-size:15px;
    classDef ops fill:#fdf2f8,stroke:#db2777,stroke-width:1.4px,color:#831843,font-size:15px;
    classDef canon fill:#f0f9ff,stroke:#0284c7,stroke-width:1.6px,color:#0c4a6e,font-size:15px;
    classDef service fill:#f5f3ff,stroke:#7c3aed,stroke-width:1.4px,color:#4c1d95,font-size:15px;
    classDef hold fill:#f8fafc,stroke:#94a3b8,stroke-dasharray:5 4,color:#475569,font-size:15px;

    subgraph source_layer["1. Source and archive"]
        direction TB
        files["compressed CMS files<br/>harmonized and corrected_resampled"]:::source
        manifest["archive manifest<br/>checksum, scope, product type"]:::archive
    end

    subgraph data_layer["2. Data boundary"]
        direction TB
        harmonized["harmonized observed lane<br/>sparse events, no hidden fill"]:::source
        loader["AWS-side historical loader<br/>compressed source first"]:::worker
        staging["staging tables<br/>typed load and registry checks"]:::buffer
        batchqa["QA gate<br/>coverage, duplicate, divergence"]:::qa
        request["promotion request<br/>evidence and rollback plan"]:::ops
        canonical["canonical observed facts<br/>measurement_1min, 15min, 1h<br/>null, gap, coverage, mask"]:::canon
        reference["reference corrected_resampled<br/>15min and 1h historical data"]:::hold
    end

    subgraph live_layer["3. Live and replay anomaly lane"]
        direction TB
        replay["live or replay event<br/>harmonized lineage preserved"]:::source
        mongo["MongoDB raw buffer<br/>recent sparse event store"]:::buffer
        processor["observed interval processor<br/>checkpoint, gap, mask"]:::worker
        candidate["candidate observed layer<br/>1min, 15min, 1h preview"]:::buffer
        liveqa["QA state and latency<br/>mask reason and evidence"]:::qa
    end

    subgraph model_layer["4. Model and serving"]
        direction TB
        anomaly_feature["anomaly input<br/>harmonized observed, null, mask"]:::ops
        forecast_feature["forecast input<br/>reference or mart corrected features"]:::ops
        registry["model registry<br/>artifact, version, contract"]:::ops
        anomaly["anomaly inference<br/>observed signal and QA mask"]:::worker
        forecast["demand forecast inference<br/>continuous feature baseline"]:::worker
        prediction["prediction result<br/>masked rows separated"]:::service
    end

    subgraph app_workflow["5. Application and workflow"]
        direction TB
        mart["mart/read models<br/>dashboard, reports, Text-to-SQL"]:::service
        api["FastAPI shell<br/>read-only query, status, jobs"]:::service
        scheduler["Airflow/scheduler<br/>batch, replay, report jobs"]:::worker
        lg["optional LangGraph review<br/>report, QA, approval only"]:::ops
        artifact["artifact store<br/>Markdown, SVG, review note"]:::service
    end

    files --> manifest
    manifest --> harmonized --> loader --> staging --> batchqa --> request --> canonical --> anomaly_feature
    manifest --> reference
    replay --> mongo --> processor --> candidate --> liveqa
    liveqa --> request
    candidate --> anomaly_feature --> anomaly --> prediction --> mart --> api
    reference --> forecast_feature --> forecast --> prediction
    registry --> anomaly
    registry --> forecast
    reference --> mart
    canonical --> mart
    api --> scheduler
    scheduler --> loader
    scheduler --> processor
    scheduler --> artifact
    request -. approval review .-> lg --> artifact
    scheduler -. report review .-> lg
