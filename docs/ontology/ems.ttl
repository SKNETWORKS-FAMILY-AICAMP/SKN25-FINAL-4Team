@prefix ems: <https://nousresearch.local/ems/ontology#> .
@prefix emsres: <https://nousresearch.local/ems/resource/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://nousresearch.local/ems/ontology> a owl:Ontology ;
    rdfs:label "EMS ontology"@en,
        "EMS 온톨로지"@ko ;
    rdfs:comment "EMS 계량기 metadata, 설비 group, 건물, 역할, redundancy 관계를 정의한 ontology artifact"@ko .

ems:AnomalyEvent a owl:Class ;
    rdfs:label "향후 anomaly event 정의"@ko .

ems:Feature a owl:Class ;
    rdfs:label "향후 feature 정의"@ko .

ems:anomalyPriority a owl:DatatypeProperty ;
    rdfs:label "이상탐지 검토 우선순위"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:integer .

ems:belongsToGroup a owl:ObjectProperty ;
    rdfs:label "meter가 equipment group에 속함"@ko ;
    rdfs:domain ems:Meter ;
    rdfs:range ems:EquipmentGroup .

ems:buildingCode a owl:DatatypeProperty ;
    rdfs:label "building 또는 zone code"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ems:definedBy a owl:ObjectProperty ;
    rdfs:label "entity 기준 문서"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range ems:MetadataDocument .

ems:equipmentGroupCode a owl:DatatypeProperty ;
    rdfs:label "equipment group code"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ems:equipmentLayer a owl:DatatypeProperty ;
    rdfs:label "equipment layer within a group"@ko ;
    rdfs:domain ems:Meter ;
    rdfs:range xsd:string .

ems:equipmentName a owl:DatatypeProperty ;
    rdfs:label "equipment name"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ems:hasGroup a owl:ObjectProperty ;
    rdfs:label "redundancy pair가 속한 group"@ko ;
    rdfs:domain ems:RedundancyPair ;
    rdfs:range ems:EquipmentGroup .

ems:hasPrimaryMeter a owl:ObjectProperty ;
    rdfs:label "redundancy pair의 primary meter"@ko ;
    rdfs:domain ems:RedundancyPair ;
    rdfs:range ems:Meter .

ems:hasRedundantMeter a owl:ObjectProperty ;
    rdfs:label "redundancy pair의 redundant meter"@ko ;
    rdfs:domain ems:RedundancyPair ;
    rdfs:range ems:Meter .

ems:hasRole a owl:ObjectProperty ;
    rdfs:label "meter의 분석 역할"@ko ;
    rdfs:domain ems:Meter ;
    rdfs:range ems:MeterRole .

ems:locatedInBuilding a owl:ObjectProperty ;
    rdfs:label "meter가 building 또는 zone에 속함"@ko ;
    rdfs:domain ems:Meter ;
    rdfs:range ems:Building .

ems:meterCount a owl:DatatypeProperty ;
    rdfs:label "group meter count"@ko ;
    rdfs:domain ems:EquipmentGroup ;
    rdfs:range xsd:integer .

ems:meterDomain a owl:DatatypeProperty ;
    rdfs:label "계측 domain"@ko ;
    rdfs:domain ems:Meter ;
    rdfs:range xsd:string .

ems:meterRoleCode a owl:DatatypeProperty ;
    rdfs:label "계량기 role code"@ko ;
    rdfs:domain ems:Meter ;
    rdfs:range xsd:string .

ems:meterUrn a owl:DatatypeProperty ;
    rdfs:label "DB meter identifier"@ko ;
    rdfs:domain ems:Meter ;
    rdfs:range xsd:string .

ems:noteFile a owl:DatatypeProperty ;
    rdfs:label "project-relative note path"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ems:primaryView a owl:DatatypeProperty ;
    rdfs:label "group 기본 검토 view"@ko ;
    rdfs:domain ems:EquipmentGroup ;
    rdfs:range xsd:string .

ems:redundantWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "중복 계량 관계"@ko ;
    rdfs:domain ems:Meter ;
    rdfs:range ems:Meter .

ems:signConvention a owl:DatatypeProperty ;
    rdfs:label "계량값 부호 해석 규칙"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ems:sourcePath a owl:DatatypeProperty ;
    rdfs:label "project-relative source path"@ko ;
    rdfs:domain ems:MetadataDocument ;
    rdfs:range xsd:string .

ems:visualizedBy a owl:ObjectProperty ;
    rdfs:label "entity를 확인할 수 있는 view"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range ems:VisualizationView .

emsres:doc_ontology_lite a owl:NamedIndividual,
        ems:MetadataDocument ;
    rdfs:label "docs/_archive/notes/meter_graph/온톨로지_요약.md" ;
    ems:sourcePath "docs/_archive/notes/meter_graph/온톨로지_요약.md" .

emsres:doc_ontology_schema a owl:NamedIndividual,
        ems:MetadataDocument ;
    rdfs:label "docs/specs/온톨로지_스키마.md" ;
    ems:sourcePath "docs/specs/온톨로지_스키마.md" .

emsres:meter_H1_K11 a owl:NamedIndividual,
        ems:Meter,
        ems:ThermalMeter ;
    rdfs:label "H1.K11" ;
    ems:anomalyPriority 3 ;
    ems:belongsToGroup emsres:group_hvac_thermal ;
    ems:buildingCode "H1" ;
    ems:definedBy emsres:doc_meter_metadata ;
    ems:equipmentGroupCode "hvac_thermal" ;
    ems:equipmentName "Emission lab HVAC 3/5" ;
    ems:hasRole emsres:role_thermal_flow ;
    ems:locatedInBuilding emsres:building_H1 ;
    ems:meterDomain "thermal" ;
    ems:meterRoleCode "thermal_flow" ;
    ems:meterUrn "H1.K11" ;
    ems:noteFile "docs/_archive/notes/meter_graph/계량기_H1_K11.md" ;
    ems:signConvention "direction_depends_on_equipment_context" ;
    ems:visualizedBy emsres:view_ems_meter_system_all .

