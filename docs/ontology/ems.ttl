    ems:hasHardwareModel emsres:hardware_SensorStar_2C ;
    ems:hasRole emsres:role_thermal_flow ;
    ems:hasSignConvention emsres:sign_direction_depends_on_equipment_context ;
    ems:locatedInBuilding emsres:building_H1 ;
    ems:meterDomain "thermal" ;
    ems:meterRoleCode "thermal_flow" ;
    ems:meterUrn "H1.K11" ;
    ems:noteFile "db:ems.meter_definition/H1.K11" ;
