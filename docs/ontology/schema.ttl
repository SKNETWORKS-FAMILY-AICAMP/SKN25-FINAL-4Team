@prefix cms: <https://nousresearch.local/cms/ontology#> .
@prefix cmsres: <https://nousresearch.local/cms/resource/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://nousresearch.local/cms/ontology> a owl:Ontology ;
    rdfs:label "CMS ontology"@en,
        "CMS 온톨로지"@ko ;
    rdfs:comment "CMS 계량기 metadata, 설비 group, 건물, 역할, redundancy 관계를 정의한 ontology artifact"@ko .

cms:AnomalyEvent a owl:Class ;
    rdfs:label "향후 anomaly event 정의"@ko .

cms:anomalyPriority a owl:DatatypeProperty ;
    rdfs:label "이상탐지 검토 우선순위"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:integer .

cms:belongsToGroup a owl:ObjectProperty ;
    rdfs:label "meter가 equipment group에 속함"@ko ;
    rdfs:domain cms:Meter ;
    rdfs:range cms:EquipmentGroup .

cms:buildingCode a owl:DatatypeProperty ;
    rdfs:label "building 또는 zone code"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

cms:definedBy a owl:ObjectProperty ;
    rdfs:label "entity 기준 문서"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range cms:MetadataDocument .

cms:equipmentGroupCode a owl:DatatypeProperty ;
    rdfs:label "equipment group code"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

cms:equipmentLayer a owl:DatatypeProperty ;
    rdfs:label "equipment layer within a group"@ko ;
    rdfs:domain cms:Meter ;
    rdfs:range xsd:string .

cms:equipmentName a owl:DatatypeProperty ;
    rdfs:label "equipment name"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

cms:hardwareModelCode a owl:DatatypeProperty ;
    rdfs:label "계량기 하드웨어 모델 코드"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

cms:hasAnomalyPriorityLevel a owl:ObjectProperty ;
    rdfs:label "이상탐지 우선순위 vocabulary"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range cms:AnomalyPriorityLevel .

cms:hasDomain a owl:ObjectProperty ;
    rdfs:label "meter의 계측 domain vocabulary"@ko ;
    rdfs:domain cms:Meter ;
    rdfs:range cms:MeterDomain .

cms:hasGroup a owl:ObjectProperty ;
    rdfs:label "redundancy pair가 속한 group"@ko ;
    rdfs:domain cms:RedundancyPair ;
    rdfs:range cms:EquipmentGroup .

cms:hasHardwareModel a owl:ObjectProperty ;
    rdfs:label "meter의 하드웨어 모델"@ko ;
    rdfs:domain cms:Meter ;
    rdfs:range cms:HardwareModel .

cms:hasPrimaryMeter a owl:ObjectProperty ;
    rdfs:label "redundancy pair의 primary meter"@ko ;
    rdfs:domain cms:RedundancyPair ;
    rdfs:range cms:Meter .

cms:hasRedundantMeter a owl:ObjectProperty ;
    rdfs:label "redundancy pair의 redundant meter"@ko ;
    rdfs:domain cms:RedundancyPair ;
    rdfs:range cms:Meter .

cms:hasRole a owl:ObjectProperty ;
    rdfs:label "meter의 분석 역할"@ko ;
    rdfs:domain cms:Meter ;
    rdfs:range cms:MeterRole .

cms:hasSignConvention a owl:ObjectProperty ;
    rdfs:label "부호 해석 vocabulary"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range cms:SignConvention .

cms:locatedInBuilding a owl:ObjectProperty ;
    rdfs:label "meter가 building 또는 zone에 속함"@ko ;
    rdfs:domain cms:Meter ;
    rdfs:range cms:Building .

cms:manufacturer a owl:DatatypeProperty ;
    rdfs:label "계량기 제조사"@ko ;
    rdfs:domain cms:HardwareModel ;
    rdfs:range xsd:string .

cms:meterCount a owl:DatatypeProperty ;
    rdfs:label "group meter count"@ko ;
    rdfs:domain cms:EquipmentGroup ;
    rdfs:range xsd:integer .

cms:meterDomain a owl:DatatypeProperty ;
    rdfs:label "계측 domain"@ko ;
    rdfs:domain cms:Meter ;
    rdfs:range xsd:string .

cms:meterRoleCode a owl:DatatypeProperty ;
    rdfs:label "계량기 role code"@ko ;
    rdfs:domain cms:Meter ;
    rdfs:range xsd:string .

cms:meterUrn a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "DB meter identifier"@ko ;
    rdfs:domain cms:Meter ;
    rdfs:range xsd:string .

cms:modelName a owl:DatatypeProperty ;
    rdfs:label "계량기 모델명"@ko ;
    rdfs:domain cms:HardwareModel ;
    rdfs:range xsd:string .

cms:noteFile a owl:DatatypeProperty ;
    rdfs:label "project-relative note path"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

cms:primaryView a owl:DatatypeProperty ;
    rdfs:label "group 기본 검토 view"@ko ;
    rdfs:domain cms:EquipmentGroup ;
    rdfs:range xsd:string .

cms:redundantWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "중복 계량 관계"@ko ;
    rdfs:domain cms:Meter ;
    rdfs:range cms:Meter .

cms:signConvention a owl:DatatypeProperty ;
    rdfs:label "계량값 부호 해석 규칙"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

cms:sourceDescription a owl:DatatypeProperty ;
    rdfs:label "metadata source description"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

cms:sourceName a owl:DatatypeProperty ;
    rdfs:label "metadata source name"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

cms:sourcePath a owl:DatatypeProperty ;
    rdfs:label "project-relative source path"@ko ;
    rdfs:domain cms:MetadataDocument ;
    rdfs:range xsd:string .

cms:sourceTable a owl:DatatypeProperty ;
    rdfs:label "metadata source table"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

cms:usesMeterSetRule a owl:ObjectProperty ;
    rdfs:label "feature가 사용하는 meter set rule"@ko ;
    rdfs:domain cms:Feature ;
    rdfs:range cms:FeatureRule .

cms:usesRedundancyPolicy a owl:ObjectProperty ;
    rdfs:label "feature rule이 사용하는 redundancy policy"@ko ;
    rdfs:domain cms:FeatureRule ;
    rdfs:range cms:RedundancyPolicy .

cms:visualizedBy a owl:ObjectProperty ;
    rdfs:label "entity를 확인할 수 있는 view"@ko ;
    rdfs:domain owl:Thing ;
    rdfs:range cms:VisualizationView .

cmsres:doc_ontology_lite a owl:NamedIndividual,
        cms:MetadataDocument ;
    rdfs:label "docs/specs/ontology.md" ;
    cms:sourcePath "docs/specs/ontology.md" .

cmsres:doc_ontology_schema a owl:NamedIndividual,
        cms:MetadataDocument ;
    rdfs:label "docs/specs/ontology.md" ;
    cms:sourcePath "docs/specs/ontology.md" .

