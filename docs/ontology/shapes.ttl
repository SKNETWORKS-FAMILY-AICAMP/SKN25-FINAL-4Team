@prefix cms: <https://nousresearch.local/cms/ontology#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cms:MeterShape a sh:NodeShape ;
    sh:targetClass cms:Meter ;
    sh:property [
        sh:path cms:belongsToGroup ;
        sh:class cms:EquipmentGroup ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:locatedInBuilding ;
        sh:class cms:Building ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:hasRole ;
        sh:class cms:MeterRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:meterUrn ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:meterDomain ;
        sh:datatype xsd:string ;
        sh:in ( "electricity" "thermal" "weather" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:meterRoleCode ;
        sh:datatype xsd:string ;
        sh:in ( "consumption" "production" "thermal_flow" "weather" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:signConvention ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:anomalyPriority ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:noteFile ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:hasHardwareModel ;
        sh:class cms:HardwareModel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

cms:HardwareModelShape a sh:NodeShape ;
    sh:targetClass cms:HardwareModel ;
    sh:property [
        sh:path cms:hardwareModelCode ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:manufacturer ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:modelName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

cms:EquipmentGroupShape a sh:NodeShape ;
    sh:targetClass cms:EquipmentGroup ;
    sh:property [
        sh:path cms:equipmentGroupCode ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:meterCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:anomalyPriority ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:noteFile ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

cms:RedundancyPairShape a sh:NodeShape ;
    sh:targetClass cms:RedundancyPair ;
    sh:message "primary and redundant meters must be different"@en ;
    sh:property [
        sh:path cms:hasPrimaryMeter ;
        sh:class cms:Meter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:hasRedundantMeter ;
        sh:class cms:Meter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:hasGroup ;
        sh:class cms:EquipmentGroup ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path cms:equipmentName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:sparql [
        sh:message "primary and redundant meters must be different"@en ;
        sh:select """
            PREFIX cms: <https://nousresearch.local/cms/ontology#>
            SELECT $this
            WHERE {
                $this cms:hasPrimaryMeter ?meter ;
                      cms:hasRedundantMeter ?meter .
            }
        """ ;
    ] .
