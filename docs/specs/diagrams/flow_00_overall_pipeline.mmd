%%{init: {"theme": "base", "layout": "elk", "flowchart": {"htmlLabels": false, "curve": "linear", "nodeSpacing": 38, "rankSpacing": 54}, "themeVariables": {"background": "#ffffff", "mainBkg": "#ffffff", "primaryColor": "#ffffff", "primaryBorderColor": "#475569", "primaryTextColor": "#0f172a", "secondaryColor": "#f8fafc", "secondaryBorderColor": "#94a3b8", "secondaryTextColor": "#0f172a", "tertiaryColor": "#ffffff", "tertiaryBorderColor": "#cbd5e1", "tertiaryTextColor": "#0f172a", "clusterBkg": "#ffffff", "clusterBorder": "#94a3b8", "edgeLabelBackground": "#ffffff", "lineColor": "#475569", "fontFamily": "Arial, sans-serif", "fontSize": "14px"}} }%%
flowchart LR
    subgraph SRC["Measurement input"]
      LIVE["live_event_source\none-month live run"]
      ARCHIVE["compressed source archive\nreference / backfill input"]
      REF_SRC["corrected_resampled reference\ncomparison only"]
    end

    subgraph APP["Application and workflow skeleton"]
      API["FastAPI\nread / status / job / chat"]
      AIRFLOW["Airflow / scheduler\nbackground batch / report job"]
      LANG["LangGraph review workflow\nQA / report / approval review"]
      RESP["dashboard / report / chat response"]
    end

    subgraph KAFKA["Kafka live ingestion buffer"]
      RAW_TOPIC["measurement_raw_v1\ningestion payload contract"]
      DLQ_TOPIC["measurement_dead_letter_v1\npoison message isolation"]
      CGROUP["postgres-live-ingest\nconsumer group / offset"]
    end

    subgraph WORKERS["Measurement workers"]
      INGEST["kafka_to_postgres_consumer\nidempotent event insert"]
      TRIGGER["common postgres trigger\npolicy lookup / 1min / queue"]
      MEAN["mean_rollup_worker\n15min / 1h mean observed"]
      PEAK["peak_feature_worker\n15min peak + rolling 1h features"]
      QAGATE["qa_eligibility_worker\nsource / policy / coverage / lineage"]
      PROMOTE["promotion_worker\ncontrolled canonical promotion"]
      REPORT["report_worker\nevidence packet / artifact"]
    end

    subgraph PG["PostgreSQL database: cms"]
      subgraph OPS["ops schema"]
        APIJOB["api_job"]
        PROMO_RUN["promotion_run"]
        ARTREF["job result_ref\nartifact / status"]
      end

      subgraph LIVE_SCHEMA["live schema"]
        LEVENT["measurement_event"]
        MPOL["measurement_policy"]
        L1["measurement_1min"]
        BQUEUE["bucket_queue\njob_kind + resolution"]
        L15["measurement_15min\nmean observed rollup"]
        L1H["measurement_1h\nmean observed rollup"]
        PCHECK["promotion_check"]
      end

      subgraph QA["qa schema"]
        PMISS["policy_miss"]
        QISSUE["live_measurement_issue"]
        QA_PACKET["QA evidence packet"]
      end

      subgraph CANON["canonical schema"]
        C1["measurement_1min"]
        C15["measurement_15min\napproved mean rollup"]
        C1H["measurement_1h\napproved mean rollup"]
        C_READY["canonical read set"]
      end

      subgraph REF["reference schema"]
        REF_CORR["corrected_resampled\naudit comparison only"]
      end

      subgraph MART["mart schema"]
        PEAK_FEATURE["peak_feature_15min"]
        PEAK_INPUT["peak_input_15min\nrolling_1h_peak_features"]
      end
    end

    subgraph KNOW["Knowledge and Ontology grounding"]
      VDB["Vector DB reference documents\nproject specs / QA / source inventory"]
      ONT["Ontology\nmeter / equipment / measurement relation"]
      GROUND["LLM grounded response generation"]
    end

    LIVE --> API
    API --> RAW_TOPIC
    RAW_TOPIC --> INGEST
    RAW_TOPIC -. validation failure .-> DLQ_TOPIC
    CGROUP --> INGEST
    INGEST --> LEVENT
    LEVENT --> TRIGGER
    MPOL --> TRIGGER
    TRIGGER --> L1
    TRIGGER --> BQUEUE
    TRIGGER -.-> PMISS
    PMISS -.-> QISSUE

    BQUEUE --> MEAN
    L1 --> MEAN
    MEAN --> L15
    MEAN --> L1H
    L15 --> QAGATE
    L1H --> QAGATE
    L1 --> QAGATE
    QISSUE --> QAGATE
    QAGATE --> PCHECK
    QAGATE --> QA_PACKET

    BQUEUE --> PEAK
    L1 --> PEAK
    PEAK --> PEAK_FEATURE
    PEAK_FEATURE --> PEAK_INPUT

    PCHECK --> PROMOTE
    PROMO_RUN --> PROMOTE
    PROMOTE --> C1
    PROMOTE --> C15
    PROMOTE --> C1H
    C1 --> C_READY
    C15 --> C_READY
    C1H --> C_READY

    ARCHIVE --> AIRFLOW
    REF_SRC --> REF_CORR
    REF_CORR --> QAGATE
    API --> APIJOB
    APIJOB --> AIRFLOW
    AIRFLOW --> REPORT
    QA_PACKET --> REPORT
    REPORT --> ARTREF
    REPORT --> LANG
    QA_PACKET --> LANG
    PCHECK --> LANG
    LANG --> API

    C_READY --> API
    QA_PACKET --> API
    PEAK_INPUT --> API
    API --> GROUND
    VDB --> GROUND
    ONT --> GROUND
    GROUND --> RESP
    API --> RESP

    classDef source fill:#ffffff,stroke:#2563eb,color:#0f172a,stroke-width:1px;
    classDef app fill:#ffffff,stroke:#7c3aed,color:#0f172a,stroke-width:1px;
