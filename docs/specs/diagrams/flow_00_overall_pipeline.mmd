    classDef worker fill:#fff7ed,stroke:#ea580c,color:#0f172a,stroke-width:1px;
    classDef pg fill:#ffffff,stroke:#64748b,color:#0f172a,stroke-width:1px;
    classDef qa fill:#fff1f2,stroke:#e11d48,color:#0f172a,stroke-width:1px;
    classDef canonical fill:#ecfdf5,stroke:#16a34a,color:#0f172a,stroke-width:1px;
    classDef reference fill:#fefce8,stroke:#ca8a04,color:#0f172a,stroke-width:1px;
    classDef mart fill:#fdf4ff,stroke:#a21caf,color:#0f172a,stroke-width:1px;
    classDef knowledge fill:#fdf4ff,stroke:#a21caf,color:#0f172a,stroke-width:1px;
    classDef hub fill:#ffffff,stroke:#334155,color:#0f172a,stroke-width:2px;

    class LIVE,ARCHIVE,REF_SRC source;
    class API,AIRFLOW,LANG,RESP app;
    class RAW_TOPIC,DLQ_TOPIC,CGROUP storage;
    class INGEST,TRIGGER,MEAN,PEAK,QAGATE,PROMOTE,REPORT worker;
    class APIJOB,PROMO_RUN,ARTREF,LEVENT,MPOL,L1,BQUEUE,L15,L1H,PCHECK pg;
    class PMISS,QISSUE qa;
    class QA_PACKET,C_READY hub;
    class C1,C15,C1H canonical;
    class REF_CORR reference;
    class PEAK_FEATURE,PEAK_INPUT mart;
    class VDB,ONT,GROUND knowledge;

    style SRC fill:#eff6ff,stroke:#2563eb,stroke-width:3px
    style APP fill:#f5f3ff,stroke:#7c3aed,stroke-width:3px
    style KAFKA fill:#ecfdf5,stroke:#059669,stroke-width:3px
    style WORKERS fill:#fff7ed,stroke:#ea580c,stroke-width:3px
    style PG fill:#eef2ff,stroke:#1d4ed8,stroke-width:4px
    style OPS fill:#ffffff,stroke:#64748b,stroke-width:1px
    style LIVE_SCHEMA fill:#ffffff,stroke:#2563eb,stroke-width:1px
    style QA fill:#fff1f2,stroke:#fecdd3,stroke-width:1px
    style CANON fill:#f0fdf4,stroke:#bbf7d0,stroke-width:1px
