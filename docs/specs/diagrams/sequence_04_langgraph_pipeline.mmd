%%{init: {"theme": "base", "sequence": {"showSequenceNumbers": true, "wrap": false, "mirrorActors": true, "rightAngles": true, "messageAlign": "center", "actorMargin": 82, "width": 170, "height": 54, "boxMargin": 12, "boxTextMargin": 8, "noteMargin": 10, "messageMargin": 44}, "themeVariables": {"background": "#ffffff", "mainBkg": "#ffffff", "primaryColor": "#f8fafc", "primaryBorderColor": "#64748b", "primaryTextColor": "#0f172a", "actorBkg": "#f8fafc", "actorBorder": "#64748b", "actorTextColor": "#0f172a", "actorLineColor": "#64748b", "signalColor": "#334155", "signalTextColor": "#0f172a", "noteBkgColor": "#fff7ed", "noteTextColor": "#0f172a", "noteBorderColor": "#ea580c", "loopTextColor": "#0f172a", "activationBkgColor": "#e0f2fe", "activationBorderColor": "#0284c7", "fontFamily": "Arial, sans-serif", "fontSize": "14px"}} }%%
sequenceDiagram
    autonumber

    box rgb(239, 246, 255) Review inputs
      participant API as FastAPI_job_path
      participant REP as report_artifact
      participant QA as QA_evidence_packet
      participant PR as promotion_request
    end

    box rgb(255, 247, 237) LangGraph async review
      participant LG as LangGraph_state
      participant RET as context_retrieval
      participant CHECK as evidence_boundary_check
      participant DEC as recommendation_node
    end

    box rgb(245, 243, 255) Grounding sources
      participant DOCS as docs_specs
      participant WIKI as LLM_Wiki_Obsidian
      participant ONT as ontology_meter_metadata
      participant DB as read_only_DB_evidence
    end

    box rgb(248, 250, 252) Outputs
      participant ART as review_artifact
      participant OPS as human_approval_queue
      participant STATUS as FastAPI_status
    end

    API->>LG: enqueue review request
    REP->>LG: attach report artifact reference
    QA->>LG: attach QA evidence packet
    PR->>LG: attach promotion request metadata
    LG->>RET: normalize state, no DB write capability
    RET->>DOCS: retrieve active CMS contracts
    RET->>WIKI: retrieve verified knowledge nodes
    RET->>ONT: retrieve meter and measurement context
    CHECK->>DB: read only supporting evidence
    RET-->>CHECK: provide grounded context
    CHECK-->>DEC: return pass warn block caveats
    DEC->>ART: write review note artifact
    DEC-->>OPS: recommend approve revise or reject
    ART-->>STATUS: expose artifact path and status

    Note over LG,OPS: LangGraph never performs canonical promotion or mutating DB writes.
