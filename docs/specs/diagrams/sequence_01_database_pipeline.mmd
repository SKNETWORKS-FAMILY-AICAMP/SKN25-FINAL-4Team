sequenceDiagram
    autonumber

    box rgb(239, 246, 255) Live measurement input
      participant SRC as live_event_source
      participant APIING as FastAPI<br/>ingest_measurements
      participant KRAW as Kafka<br/>measurement_raw_v1
      participant KDLQ as DLQ<br/>measurement_dead_letter_v1
    end

    box rgb(255, 247, 237) Live processing workers
      participant ING as kafka_to_postgres_consumer
      participant TRG as postgres_trigger
      participant MEAN as mean_rollup_worker
      participant PEAK as peak_feature_worker
      participant QAW as qa_eligibility_worker
      participant PROM as promotion_worker
    end

    box rgb(238, 242, 255) PostgreSQL database: cms
      participant LE as live.measurement_event
      participant POL as live.measurement_policy
      participant L1 as live.measurement_1min
      participant BQ as live.bucket_queue<br/>job_kind_resolution
      participant LR as live.mean_15min_1h
      participant PMISS as qa.policy_miss
      participant ISSUE as qa.live_measurement_issue
      participant CHECK as live.promotion_check
      participant RUN as live.promotion_run
    end

    box rgb(245, 243, 255) Consumers and outputs
      participant CAN as canonical.mean_measurement_*
      participant PF as mart.peak_feature_15min
      participant PI as mart.peak_feature_15min<br/>rolling_1h_features
      participant SVC as service_consumers
    end

    SRC->>APIING: POST observed live event
    APIING->>KRAW: validate and publish raw event, return 202
    APIING-->>SRC: invalid API payload returns 422 without Kafka publish
    KRAW->>ING: consume Kafka envelope
    ING->>LE: idempotent insert observed event ledger row then commit offset
    ING-->>KDLQ: consumer validation failure goes to DLQ then commit offset
    LE->>TRG: fire common AFTER INSERT trigger
    TRG->>POL: lookup meter and measurement policy

    alt policy found and event valid
        TRG->>L1: upsert aligned 1min observed bucket
        TRG->>BQ: enqueue mean_rollup 15min and 1h jobs
        TRG->>BQ: enqueue peak_feature 15min job
    else policy miss
        TRG-->>PMISS: create policy_miss box event
        PMISS-->>ISSUE: record live_measurement_issue
    end

    par anomaly mean rollup path
        BQ->>MEAN: claim mean_rollup job by resolution
        MEAN->>L1: read child rows and coverage evidence
        MEAN->>LR: upsert mean observed 15min or 1h candidate
    and peak prediction feature path
        BQ->>PEAK: claim peak_feature 15min job
        PEAK->>L1: read child observed rows
        PEAK->>PF: upsert peak_value peak_ts max feature
        PF-->>PI: optional helper projection when maintained
    end

    QAW->>L1: read 1min candidate rows
    QAW->>LR: read mean 15min and 1h candidate rows
    QAW->>ISSUE: read blocking issues
    QAW->>CHECK: write pass warn block result
    QAW-->>SVC: expose QA evidence packet

    alt eligible observed mean row
        CHECK->>PROM: release eligible rows
        PROM->>RUN: register promotion_id and counts
        PROM->>CAN: controlled upsert mean measurement_1min_15min_1h
        CAN-->>SVC: read-only canonical evidence
    else blocked row
        ISSUE-->>SVC: expose block reason only
    end

    PF-->>SVC: direct P-Max runtime input path

    Note over TRG,BQ: trigger enqueues work only. Mean and peak calculations stay in workers
    Note over MEAN,PEAK: live 15min and 1h store mean observed rollup. Peak values stay in mart
    Note over CHECK,CAN: canonical write requires eligibility and promotion_id. Peak features are not canonical facts
