flowchart LR
    subgraph TRIG["Workflow triggers"]
      SCHED["schedule"]
      MANUAL["manual ops job"]
      APIJOB["FastAPI ops job
read/write gate"]
    end

    subgraph PC1["PC1 Airflow / scheduler lane"]
      AF["cms-airflow-standalone"]
      REPORT["report DAGs
daily / weekly / monthly"]
      REPLAY["replay planning
2023 virtual time"]
      BUCKET["bucket queue maintenance
mean rollup / peak feature"]
      STATUS["ops job status
artifact ref"]
    end

    subgraph PC3["PC3 operational scheduler lane"]
      MODEL_SCHED["hybrid model-serving scheduler
15min P-Max / hourly anomaly"]
      ANOMAT["anomaly feature worker"]
      CANON["canonical promotion worker
approval gated"]
    end

    subgraph AWS["AWS PostgreSQL evidence"]
      LIVE["live.*
measurement and queues"]
      MART["mart.*
features forecasts warnings"]
      OPS["ops.*
inference / job logs"]
      QA["qa.*
evidence packets"]
      CAN["canonical.*
approved only"]
    end

    subgraph SERV["Service surface"]
      API["CMS Backend API
read status / artifacts"]
      FRONT["Frontend / Grafana
operator evidence"]
    end

    SCHED --> AF
    MANUAL --> AF
    APIJOB --> AF
    AF --> REPORT
    AF --> REPLAY
    AF --> BUCKET
    BUCKET --> LIVE
    BUCKET --> MART
    LIVE --> REPORT
    MART --> REPORT
    QA --> REPORT
    REPORT --> STATUS
    STATUS --> API

    SCHED --> MODEL_SCHED
    MODEL_SCHED --> MART
    MODEL_SCHED --> OPS
    MODEL_SCHED --> QA
    SCHED --> ANOMAT
    ANOMAT --> MART
    MANUAL --> CANON
    APIJOB --> CANON
    CANON --> CAN
    CANON --> OPS
    API --> FRONT
    OPS --> API
    QA --> API
    MART --> API


