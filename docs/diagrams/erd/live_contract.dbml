  last_error text
  locked_by text
  locked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (status, job_kind, bucket_ts, locked_at) [name: 'bucket_queue_claim_idx']
  }
}

Table live.promotion_check [headercolor: #2563EB, note: 'QA eligibility result before controlled canonical promotion.'] {
