Table live.bucket_queue [headercolor: #2563EB, note: 'Worker queue for mean_rollup and peak_feature jobs.'] {
  queue_id bigint [pk]
  meter_urn text [not null]
  measurement text [not null]
  resolution text [not null]
  bucket_ts timestamptz [not null]
