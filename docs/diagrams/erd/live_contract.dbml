Table ops.metric [headercolor: #2563EB, note: 'Run/gate metric ledger used by Grafana evidence panels.'] {
  metric_id bigint [pk]
  metric_ts timestamptz [not null]
  run_id text [not null]
  stage text [not null]
  metric_name text [not null]
  metric_value double [not null]
  unit text [not null]
  labels jsonb [not null]
  created_at timestamptz [not null]

  indexes {
    (run_id, stage, metric_name)
    (metric_ts)
  }
}

Table ops.latency [headercolor: #2563EB, note: 'Per-stage and end-to-end latency evidence.'] {
  latency_id bigint [pk]
  run_id text [not null]
  evidence_level text [not null]
  stage text [not null]
  event_id text
  meter_urn text
  measurement text
  bucket_ts timestamptz
  created_at timestamptz [not null]
  duration_sec double
  source_to_fastapi_sec double
  fastapi_to_kafka_sec double
  kafka_to_event_sec double
  event_to_1min_sec double
  event_to_queue_sec double
  one_min_to_15min_sec double
  one_min_to_1h_sec double
  one_min_to_peak_feature_sec double
  peak_feature_to_peak_input_sec double
  qa_eligibility_sec double
  promotion_ready_sec double
  end_to_end_sec double
  kafka_consumer_lag bigint
  kafka_dlq_count bigint
  kafka_produce_error_count bigint
  fastapi_ingest_request_rate double
  fastapi_ingest_4xx_count bigint
  fastapi_ingest_5xx_count bigint
  fastapi_ingest_p95_ms double
  blocked_count integer [not null]
  failed_count integer [not null]
  retry_count integer [not null]
  details jsonb [not null]

  indexes {
    (run_id, stage, created_at)
    (meter_urn, measurement, bucket_ts)
  }
}

Table ops.worker_heartbeat [headercolor: #2563EB, note: 'Worker liveness and processing counters.'] {
  worker_name text [pk]
  status text [not null]
  heartbeat_at timestamptz [not null]
  updated_at timestamptz [not null]
  last_error text
  restart_count integer [not null]
  processed_count bigint [not null]
  failed_count bigint [not null]
  details jsonb [not null]
}

Table ops.worker_event_log [headercolor: #2563EB, note: 'Worker event and processing history deltas.'] {
  event_id bigint [pk]
  worker_name text [not null]
  event_at timestamptz [not null]
  status text [not null]
  processed_delta bigint [not null]
  failed_delta bigint [not null]
  restart_delta integer [not null]
  error_message text
  details jsonb [not null]
}

Table ops.consumer_lag [headercolor: #2563EB, note: 'SQL-backed Kafka lag snapshot. Live dashboards prefer the Prometheus exporter.'] {
  observed_at timestamptz [not null]
  topic text [not null]
  consumer_group text [not null]
  partition integer
  current_offset bigint
  high_watermark bigint
  lag bigint [not null]
  details jsonb [not null]

  indexes {
    (observed_at, topic, consumer_group, partition)
  }
}

Table ops.pmax_log [headercolor: #2563EB, note: 'P-Max inference run status and quality log.'] {
  run_id text [pk]
  base_ts timestamptz [not null]
  status text [not null]
