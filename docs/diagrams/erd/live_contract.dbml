Table mart.peak_feature_15min [headercolor: #2563EB, note: 'Direct P-Max runtime input feature. Keyed by window_ts and run_id; not canonical observed truth.'] {
  window_ts timestamptz [not null]
  meter_urn text [not null]
  measurement text [not null]
  mean_value double
  max_value double
  min_value double
  p95_value double
  p99_value double
  std_value double
  last_value double
  peak_ts timestamptz
  peak_value double
  observed_points integer [not null]
  expected_points integer [not null]
  coverage_ratio double [not null]
  source_file text [not null]
  run_id text [not null]
  created_at timestamptz [not null]
  source_layer text
  source_mode text
  provenance jsonb

  indexes {
    (window_ts, meter_urn, measurement, run_id) [pk]
    (meter_urn, measurement, window_ts)
  }
}

