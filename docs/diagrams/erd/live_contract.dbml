  details jsonb [not null]
  started_at timestamptz [not null]
  completed_at timestamptz

  indexes {
    (base_ts)
    (status, quality_status)
  }
}

Table ops.anomaly_log [headercolor: #2563EB, note: 'Anomaly warning inference run log.'] {
