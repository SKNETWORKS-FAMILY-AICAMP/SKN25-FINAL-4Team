  model_urn text [not null]
  forecast_origin_ts timestamptz [not null]
  target_ts timestamptz [not null]
  lead_step integer [not null]
  horizon_hours integer [not null]
  predicted_p double
  threshold_lower double
  threshold_upper double
  warning_flag boolean [not null]
  warning_type text [not null]
  status text [not null]
  physical_flag boolean [not null]
  input_quality text [not null]
  warning_reason_code text [not null]
  source_input_refs jsonb [not null]
  created_at timestamptz [not null]
  input_missing_count integer
  input_physical_count integer
  physical_issue_types text
  physical_issue_recent_count integer
  physical_issue_pattern text
  physical_issue_detail text

  indexes {
    (meter_urn, forecast_origin_ts, lead_step) [unique, name: 'anomaly_warning_1h_meter_origin_lead_uq']
  }
}

