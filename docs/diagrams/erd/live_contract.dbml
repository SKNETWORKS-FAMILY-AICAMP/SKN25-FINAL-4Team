Project cms_live_pipeline_contract {
  database_type: 'PostgreSQL'
  Note: '''
  CMS live pipeline ERD for dbdiagram.io.

  All tables below were verified against the AWS `cms` database (13.209.98.228) on 2026-06-24
  and are deployed/read-back. Blue headers mark AWS-confirmed deployed tables. The previous
  blue/orange (deployed vs target) split is retired because every prior target table is now live.

  Scope: live ingestion -> live rollup/queue -> QA eligibility -> canonical promotion ->
  mart model-serving (P-Max / anomaly) + ops/qa evidence. App/report/training surfaces that
  also exist in the DB are out of scope here: ops.chat_session, ops.chat_message,
  ops.daily_report, ops.weekly_report, ops.monthly_report, ops.report_archive, ops.energy_doc,
  ops.work_order, ops.control_action, ops.model_artifact, ops.langgraph_jobs,
  ops.exclusion_window, ops.live_replay_checkpoint, ops.resample_run, ops.resample_file,
  ops.physical_anomaly_1h, ops.anomaly_label_1h, qa.router_eval_case.

  Sources:
  - AWS cms DB information_schema / pg_constraint (verified 2026-06-24)
  - docs/specs/database_contract.md
  - docs/specs/data_platform_contract.md
  '''
}

Table live.measurement_event [headercolor: #2563EB, note: 'Kafka to PostgreSQL ingress ledger. source_layer DB default is the legacy kafka.measurement_raw_v1 literal; active topics are measurement_live_v1 / measurement_backfill_v1.'] {
  event_id text [pk]
  business_idempotency_key text [not null]
  source_event_id text
  meter_urn text [not null]
  measurement text [not null]
  event_ts timestamptz [not null]
  value_text text
  value_numeric double
  unit text
  source_layer text [not null, default: 'kafka.measurement_raw_v1']
  source_ref text
  ingested_at timestamptz [not null, default: `now()`]
  received_at timestamptz
  raw_payload_hash text
  kafka_topic text
  kafka_partition integer
  kafka_offset bigint
  kafka_key text
  consumer_group text
  consumed_at timestamptz
  schema_version text
  policy_lookup_status text [not null, default: 'pending']

  indexes {
    (meter_urn, measurement, event_ts) [name: 'measurement_event_lookup_idx']
    (policy_lookup_status, event_ts) [name: 'measurement_event_policy_status_idx']
  }
}

Table live.measurement_policy [headercolor: #2563EB, note: 'Meter and measurement processing policy resolved by the ingest trigger.'] {
  policy_id bigint [pk]
  meter_urn text [not null]
  measurement text [not null]
  effective_from timestamptz [not null]
  effective_to timestamptz
  enabled boolean [not null, default: true]
  source_update_mode text [not null]
  cadence_group text [not null]
  source_native_interval_seconds integer
  target_resolution_policy text [not null]
  value_policy text [not null]
  aggregation_policy text [not null]
  expected_points_policy jsonb [not null]
  mean_rollup_enabled boolean [not null, default: true]
  peak_feature_enabled boolean [not null, default: false]
  coverage_threshold numeric
  max_state_hold_age_seconds integer
  canonical_eligible boolean [not null, default: false]
  paper_policy_ref text
  policy_version integer [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (meter_urn, measurement, enabled, effective_from, effective_to) [name: 'measurement_policy_lookup_idx']
  }
}

Table live.measurement_1min [headercolor: #2563EB, note: 'Aligned 1min observed candidate written by the ingest trigger.'] {
  bucket_ts timestamptz [not null]
  resolution text [not null, default: '1min']
  meter_urn text [not null]
  measurement text [not null]
  value double
  unit text
  aggregation_policy text [not null]
  expected_points integer [not null]
  observed_points integer [not null]
  missing_points integer [not null]
  coverage_ratio numeric [not null]
  mask_code text
  quality_code text
  quality_summary jsonb [not null]
  provenance jsonb [not null]
  source_event_ids text_array [not null]
  source_bucket_refs text_array [not null]
  source_run_id text
  policy_id bigint
  policy_version integer [not null]
  lineage_key text
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (meter_urn, measurement, resolution, bucket_ts, policy_version) [pk]
  }
}

