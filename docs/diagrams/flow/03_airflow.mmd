flowchart LR
    subgraph TRIG["Workflow triggers"]
      SCHED["schedule"]
      MANUAL["manual ops job"]
      APIJOB["cms-backend-api ops job
read/write gate"]
    end

    subgraph PC1["PC1 Airflow / worker lane"]
      AF["cms-airflow-standalone
cms-airflow-scheduler"]
      REPORT["report DAGs
daily / weekly / monthly"]
      REPLAY["replay DAG
live / backfill replay"]
      WORKERS["rollup / peak workers
mean_rollup / peak_feature"]
      CANON["canonical_promotion_worker
approval gated"]
      STATUS["ops job status
artifact ref"]
    end

    subgraph PC3["PC3 model-serving lane"]
      PMAXS["pmax_scheduler
15min P-Max forecast"]
      ANOMS["anomaly_scheduler
hourly anomaly warnings"]
      ANOMAT["cms-anomaly-feature-worker
1h feature materialization"]
    end

    subgraph AWS["AWS PostgreSQL evidence"]
      LIVE["live.*
measurement and queues"]
      MART["mart.*
features forecasts warnings"]
      OPS["ops.*
inference / job logs"]
      QA["qa.*
evidence packets"]
      CAN["canonical.*
approved only"]
    end

    subgraph SERV["Service surface"]
      API["cms-backend-api
read status / artifacts"]
      FRONT["Frontend / Grafana
operator evidence"]
    end

    SCHED --> AF
    MANUAL --> AF
    APIJOB --> AF
    AF --> REPORT
    AF --> REPLAY
    AF --> WORKERS
    WORKERS --> LIVE
    WORKERS --> MART
    LIVE --> REPORT
    MART --> REPORT
    QA --> REPORT
    REPORT --> STATUS
    STATUS --> API

    SCHED --> PMAXS
    PMAXS --> MART
    PMAXS --> OPS
    PMAXS --> QA
    SCHED --> ANOMS
    ANOMS --> MART
    ANOMS --> OPS
    SCHED --> ANOMAT
    ANOMAT --> MART
    MANUAL --> CANON
    APIJOB --> CANON
    CANON --> CAN
    CANON --> OPS
    API --> FRONT
    OPS --> API
    QA --> API
    MART --> API


