flowchart LR
    subgraph USER["Operator / user surface"]
      UI["cms-agent-frontend"]
      GRAF["Grafana dashboards
PC2"]
      CLIENT["API client"]
    end

    subgraph PC1["PC1 FastAPI services"]
      ING["cms-ingestion-api
private write boundary"]
      BACK["cms-backend-api
read / status / jobs / chat"]
      ROUTER["routers
forecast / simulator / ops / query"]
      GUARD["side-effect guard
writes_allowed=false by default"]
    end

    subgraph DATA["Data and runtime backends"]
      KAFKA["Kafka measurement_live_v1"]
      AWSDB["AWS PostgreSQL
live / mart / ops / qa / canonical"]
      PC3MODEL["PC3 model-serving
cms-model-ops-api / P-Max / anomaly"]
      ART["artifact / report refs"]
    end

    subgraph KNOW["Knowledge-assisted answers"]
      SQL["SQLLM SELECT whitelist"]
      DOCS["docs/specs + ontology"]
      REVIEW["optional LangGraph review
async only"]
    end

    CLIENT --> ING
    ING --> KAFKA
    UI --> BACK
    CLIENT --> BACK
    BACK --> ROUTER
    ROUTER --> GUARD
    GUARD --> SQL
    SQL --> AWSDB
    AWSDB --> BACK
    PC3MODEL --> AWSDB
    ART --> BACK
    BACK --> UI
    BACK --> GRAF
    AWSDB --> GRAF
    DOCS --> BACK
    BACK --> REVIEW
    REVIEW --> ART


    classDef source fill:#ffffff,stroke:#2563eb,color:#0f172a,stroke-width:1px;
    classDef api fill:#ffffff,stroke:#7c3aed,color:#0f172a,stroke-width:1px;
