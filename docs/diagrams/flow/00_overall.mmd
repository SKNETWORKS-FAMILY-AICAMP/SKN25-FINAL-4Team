    classDef reference fill:#fefce8,stroke:#ca8a04,color:#0f172a,stroke-width:1px;
    classDef mart fill:#fdf4ff,stroke:#a21caf,color:#0f172a,stroke-width:1px;
    classDef knowledge fill:#fdf4ff,stroke:#a21caf,color:#0f172a,stroke-width:1px;
