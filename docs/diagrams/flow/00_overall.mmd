    class LIVE,ARCHIVE,REF_SRC source;
    class INGEST_API,BACKEND,FRONTEND,AIRFLOW,MODEL_SCHED,LANG,RESP app;
    class RAW_TOPIC,DLQ_TOPIC,CGROUP storage;
    class INGEST,TRIGGER,MEAN,PEAK,ANOM,PMAX_LOAD,QAGATE,PROMOTE,REPORT worker;
    class APIJOB,PROMO_RUN,ARTREF,PMAX_LOG,LEVENT,MPOL,L1,BQUEUE,L15,L1H,PCHECK pg;
    class LISSUE,PMAX_EVAL qa;
    class QA_PACKET,C_READY hub;
    class C1,C15,C1H canonical;
    class REF15,REF1H reference;
    class PEAK_FEATURE,PMAX_FORECAST,ANOM_FEATURE,ANOM_WARN mart;
    class VDB,ONT,GROUND knowledge;

