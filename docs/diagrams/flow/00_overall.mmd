%%{init: {"theme": "base", "layout": "elk", "flowchart": {"htmlLabels": false, "curve": "linear", "nodeSpacing": 38, "rankSpacing": 54}, "themeVariables": {"background": "#ffffff", "mainBkg": "#ffffff", "primaryColor": "#ffffff", "primaryBorderColor": "#475569", "primaryTextColor": "#0f172a", "secondaryColor": "#f8fafc", "secondaryBorderColor": "#94a3b8", "secondaryTextColor": "#0f172a", "tertiaryColor": "#ffffff", "tertiaryBorderColor": "#cbd5e1", "tertiaryTextColor": "#0f172a", "clusterBkg": "#ffffff", "clusterBorder": "#94a3b8", "edgeLabelBackground": "#ffffff", "lineColor": "#475569", "fontFamily": "Arial, sans-serif", "fontSize": "14px"}} }%%
flowchart LR
    subgraph SRC["Measurement input"]
      LIVE["live event stream\nPC1 replay / ingestion"]
      ARCHIVE["compressed source archive\nreference / backfill input"]
      REF_SRC["corrected_resampled reference\nwarm-start / comparison input"]
    end

    subgraph APP["Application and workflow runtime"]
      INGEST_API["cms-ingestion-api\nPOST /ingest/measurements"]
      BACKEND["cms-backend-api\nread / status / job / chat"]
      FRONTEND["cms-frontend / dashboard\npublic UI"]
      AIRFLOW["Airflow scheduler\nreadiness / batch / report orchestration"]
      MODEL_SCHED["pmax_scheduler / anomaly_scheduler\nPC3 model serving"]
      LANG["LangGraph review workflow\nQA / report / approval review"]
      RESP["dashboard / report / chat response"]
    end

    subgraph KAFKA["Kafka live ingestion buffer"]
      RAW_TOPIC["measurement_live_v1\n+ measurement_backfill_v1"]
      DLQ_TOPIC["measurement_dead_letter_v1\npoison message isolation"]
      CGROUP["postgres-live-ingest\nconsumer group / offset"]
    end

    subgraph WORKERS["Measurement and model workers"]
      INGEST["kafka_live_consumer_pc1\nidempotent PostgreSQL insert"]
      TRIGGER["common PostgreSQL trigger\npolicy lookup / 1min / queue"]
      MEAN["cms_live_mean_rollup_worker\n15min / 1h mean observed"]
      PEAK["cms_peak_feature_worker\n15min peak features"]
      ANOM["cms-anomaly-feature-worker\n1h feature and warning facts"]
      PMAX_LOAD["P-Max release loader\n288 windows -> forecast facts"]
      QAGATE["QA eligibility gate\npromotion_check / evidence"]
      PROMOTE["canonical_promotion_worker\nPC1 approval-gated promotion"]
      REPORT["report worker\nevidence packet / artifact"]
    end

    subgraph PG["PostgreSQL database: cms"]
      subgraph OPS["ops schema"]
        APIJOB["api_job"]
        PROMO_RUN["promotion_run"]
        ARTREF["job result_ref\nartifact / status"]
        PMAX_LOG["pmax_log\nmodel / release lineage"]
      end

      subgraph LIVE_SCHEMA["live schema"]
        LEVENT["measurement_event"]
        MPOL["measurement_policy"]
        L1["measurement_1min"]
        BQUEUE["bucket_queue\nmean_rollup / peak_feature jobs"]
        L15["measurement_15min\nmean observed rollup"]
        L1H["measurement_1h\nmean observed rollup"]
        PCHECK["promotion_check"]
      end

      subgraph QA["qa schema"]
        LISSUE["live_issue"]
        QA_PACKET["QA evidence packet"]
        PMAX_EVAL["pmax_eval\nforecast quality evidence"]
      end

      subgraph CANON["canonical schema"]
        C1["measurement_1min\napproved observed rows"]
        C15["measurement_15min\napproved mean rollup"]
        C1H["measurement_1h\napproved mean rollup"]
        C_READY["canonical read set"]
      end

      subgraph REF["reference schema"]
        REF15["corrected_resampled_15min\nreference_backfill leg"]
        REF1H["corrected_resampled_1h\nanomaly warm-start leg"]
      end

      subgraph MART["mart schema"]
        PEAK_FEATURE["peak_feature_15min\nP-Max live feature input"]
        PMAX_FORECAST["pmax_forecast_15min\nreleased P-Max forecasts"]
        ANOM_FEATURE["anomaly_feature_1h\nanomaly model input"]
        ANOM_WARN["anomaly_warning_1h\nwarning facts"]
      end
    end

    subgraph KNOW["Knowledge and ontology grounding"]
      VDB["Vector DB reference documents\nproject specs / QA / source inventory"]
      ONT["Ontology\nmeter / equipment / measurement relation"]
      GROUND["LLM grounded response generation"]
    end

    LIVE --> INGEST_API
    INGEST_API --> RAW_TOPIC
    RAW_TOPIC --> INGEST
    RAW_TOPIC -. validation failure .-> DLQ_TOPIC
    CGROUP --> INGEST
    INGEST --> LEVENT
    LEVENT --> TRIGGER
    MPOL --> TRIGGER
    TRIGGER --> L1
    TRIGGER --> BQUEUE
    TRIGGER -. policy or quality issue .-> LISSUE

    BQUEUE --> MEAN
    L1 --> MEAN
    MEAN --> L15
    MEAN --> L1H
    MEAN --> PCHECK
    L15 --> QAGATE
    L1H --> QAGATE
    L1 --> QAGATE
    LISSUE --> QAGATE
    QAGATE --> PCHECK
    QAGATE --> QA_PACKET

    BQUEUE --> PEAK
    L1 --> PEAK
    PEAK --> PEAK_FEATURE
    PEAK_FEATURE --> MODEL_SCHED
    MODEL_SCHED --> PMAX_LOAD
    PMAX_LOAD --> PMAX_FORECAST
    PMAX_LOAD --> PMAX_LOG
    PMAX_FORECAST --> PMAX_EVAL

    REF1H --> ANOM
    ANOM_FEATURE --> ANOM
    MODEL_SCHED --> ANOM
    ANOM --> ANOM_FEATURE
    ANOM --> ANOM_WARN

    PCHECK --> PROMOTE
    PROMO_RUN --> PROMOTE
    PROMOTE --> C1
    PROMOTE --> C15
    PROMOTE --> C1H
    C1 --> C_READY
    C15 --> C_READY
    C1H --> C_READY

    ARCHIVE --> AIRFLOW
    REF_SRC --> REF15
    REF_SRC --> REF1H
    REF15 --> QAGATE
    APIJOB --> AIRFLOW
    AIRFLOW --> REPORT
    AIRFLOW --> MODEL_SCHED
    QA_PACKET --> REPORT
    REPORT --> ARTREF
    REPORT --> LANG
    QA_PACKET --> LANG
    PCHECK --> LANG
    LANG --> BACKEND

    BACKEND --> APIJOB
    C_READY --> BACKEND
    QA_PACKET --> BACKEND
    PEAK_FEATURE --> BACKEND
    PMAX_FORECAST --> BACKEND
    ANOM_WARN --> BACKEND
    BACKEND --> GROUND
    VDB --> GROUND
    ONT --> GROUND
    GROUND --> RESP
    BACKEND --> RESP
    FRONTEND --> BACKEND
    FRONTEND --> RESP

