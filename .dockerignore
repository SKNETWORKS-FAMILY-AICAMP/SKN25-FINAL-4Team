# Build context hygiene for CMS A-to-Z image builds
.git
.gitignore
.dockerignore

incoming/
docs/
artifacts/external/

**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/

frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.cache/

runtime_secrets/
logs/
artifacts/
*.log
*.bak
*.orig
*.rej
.env
**/.env
**/*.env
!**/*.env.example
