# Non-secret AWS Phase 1 environment example.
# Copy this on the target server and fill secrets locally.
# Do not commit or paste real passwords, tokens, or connection strings.

CMS_ENV=aws_phase1
CMS_NODE_ROLE=stream

# Node identity
CMS_DB_PUBLIC_IP=13.209.98.228
CMS_DB_PRIVATE_IP=172.31.47.236
CMS_STREAM_PUBLIC_IP=43.202.114.249
CMS_STREAM_PRIVATE_IP=172.31.26.245

# Kafka internal runtime on cms-stream
KAFKA_BOOTSTRAP_SERVERS=cms-kafka:9092
MEASUREMENT_RAW_TOPIC=measurement_raw_v1
MEASUREMENT_DLQ_TOPIC=measurement_dead_letter_v1
KAFKA_CONSUMER_GROUP=postgres-live-ingest

# FastAPI
CMS_API_BIND=127.0.0.1
CMS_API_HOST=0.0.0.0
CMS_API_PORT=8000
CMS_ENABLE_RUNTIME_KAFKA_PRODUCER=1

# PostgreSQL target on cms-db.
# Fill POSTGRES_PASSWORD on the server only.
POSTGRES_HOST=172.31.47.236
POSTGRES_PORT=5432
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

# Kafka retention for Phase 1 smoke. Keep short until capacity is proven.
KAFKA_LOG_RETENTION_HOURS=24
KAFKA_LOG_RETENTION_BYTES=1073741824

# Prometheus on cms-stream. Bind to private IP only when Grafana on cms-db must query it.
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=7d

# Safety gates
ALLOW_DB_SCRATCH_WRITE=0
ALLOW_CANONICAL_WRITE=0
ALLOW_PRODUCTION_DDL=0
