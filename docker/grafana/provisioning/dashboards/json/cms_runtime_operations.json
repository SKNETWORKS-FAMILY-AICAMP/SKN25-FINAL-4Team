    {
      "id": 9,
      "type": "stat",
      "title": "Latest retry",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (SELECT run_id FROM ops.pipeline_metric GROUP BY run_id ORDER BY max(metric_ts) DESC LIMIT 1) SELECT COALESCE(max(metric_value), 0) AS latest_retry FROM ops.pipeline_metric WHERE run_id IN (SELECT run_id FROM latest) AND metric_name IN ('consumer_retry','retry');"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
