      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH recent AS (\n  SELECT\n    meter_urn,\n    measurement,\n    count(*) FILTER (WHERE consumed_at >= now() - interval '15 minutes') AS events_15m,\n    count(*) FILTER (WHERE consumed_at >= now() - interval '1 hour') AS events_1h,\n    max(event_ts) AS latest_event_ts,\n    max(consumed_at) AS latest_consumed_at,\n    max(consumed_at) FILTER (WHERE policy_lookup_status = 'resolved') AS latest_resolved_consumed_at,\n    count(*) FILTER (WHERE policy_lookup_status <> 'resolved') AS unresolved_events_1h,\n    max(policy_lookup_status) AS latest_policy_lookup_status\n  FROM live.measurement_event\n  WHERE consumed_at >= now() - interval '24 hours'\n  GROUP BY meter_urn, measurement\n)\nSELECT\n  meter_urn,\n  measurement,\n  events_15m,\n  events_1h,\n  latest_event_ts,\n  latest_consumed_at,\n  EXTRACT(EPOCH FROM now() - latest_consumed_at) AS consumed_age_sec,\n  EXTRACT(EPOCH FROM latest_consumed_at - latest_event_ts) AS latest_source_to_consume_sec,\n  latest_resolved_consumed_at,\n  unresolved_events_1h,\n  latest_policy_lookup_status\nFROM recent\nORDER BY consumed_age_sec DESC, events_1h ASC, meter_urn, measurement\nLIMIT 200;"
