    {
      "id": 12,
      "type": "stat",
      "title": "Latest invariant delta",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (SELECT run_id FROM ops.pipeline_metric GROUP BY run_id ORDER BY max(metric_ts) DESC LIMIT 1), pivot AS (SELECT metric_name, max(metric_value) AS v FROM ops.pipeline_metric WHERE run_id IN (SELECT run_id FROM latest) GROUP BY metric_name) SELECT COALESCE((SELECT v FROM pivot WHERE metric_name='consumer_processed'),0) - COALESCE((SELECT v FROM pivot WHERE metric_name='consumer_inserted'),0) - COALESCE((SELECT v FROM pivot WHERE metric_name='consumer_duplicate'),0) - COALESCE((SELECT v FROM pivot WHERE metric_name='consumer_dlq'),0) AS invariant_delta;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
