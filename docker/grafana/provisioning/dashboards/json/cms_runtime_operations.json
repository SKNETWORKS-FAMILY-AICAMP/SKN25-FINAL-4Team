{
  "uid": "cms-runtime-operations",
  "title": "CMS Runtime Operations",
  "tags": [
    "cms",
    "operations",
    "runtime",
    "pipeline",
    "server"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
