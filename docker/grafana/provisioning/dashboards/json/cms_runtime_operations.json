    {
      "id": 12,
      "type": "stat",
      "title": "Latest invariant delta",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (SELECT run_id FROM ops.pipeline_metric GROUP BY run_id ORDER BY max(metric_ts) DESC LIMIT 1), pivot AS (SELECT metric_name, max(metric_value) AS v FROM ops.pipeline_metric WHERE run_id IN (SELECT run_id FROM latest) GROUP BY metric_name) SELECT COALESCE((SELECT v FROM pivot WHERE metric_name='consumer_processed'),0) - COALESCE((SELECT v FROM pivot WHERE metric_name='consumer_inserted'),0) - COALESCE((SELECT v FROM pivot WHERE metric_name='consumer_duplicate'),0) - COALESCE((SELECT v FROM pivot WHERE metric_name='consumer_dlq'),0) AS invariant_delta;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Recent blocking issues",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT issue_ts, issue_kind, severity, meter_urn, measurement, details FROM qa.live_measurement_issue WHERE severity IN ('high','critical','blocking') ORDER BY issue_ts DESC LIMIT 50;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0,
                        "text": "critical"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "blocking": {
                        "color": "red",
                        "index": 1,
                        "text": "blocking"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "high": {
                        "color": "orange",
                        "index": 2,
                        "text": "high"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "medium": {
                        "color": "yellow",
                        "index": 3,
                        "text": "medium"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "low": {
                        "color": "green",
                        "index": 4,
                        "text": "low"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
    {
