      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT metric_ts, run_id, stage, metric_name, metric_value, unit FROM ops.pipeline_metric ORDER BY metric_ts DESC LIMIT 100;"
