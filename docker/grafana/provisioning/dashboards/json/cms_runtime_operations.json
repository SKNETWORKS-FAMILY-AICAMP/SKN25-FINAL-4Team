    {
      "id": 13,
      "type": "table",
      "title": "Recent blocking issues",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT issue_ts, issue_kind, severity, meter_urn, measurement, details FROM qa.live_measurement_issue WHERE severity IN ('high','critical','blocking') ORDER BY issue_ts DESC LIMIT 50;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
