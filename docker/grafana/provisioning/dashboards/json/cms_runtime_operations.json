      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (\n  SELECT\n    meter_urn,\n    measurement,\n    max(event_ts) AS latest_event_ts,\n    max(consumed_at) AS latest_consumed_at,\n    count(*) AS events_24h\n  FROM live.measurement_event\n  WHERE consumed_at >= now() - interval '24 hours'\n  GROUP BY meter_urn, measurement\n)\nSELECT\n  meter_urn,\n  measurement,\n  latest_event_ts,\n  latest_consumed_at,\n  EXTRACT(EPOCH FROM now() - latest_consumed_at) AS consumed_age_sec,\n  events_24h,\n  CASE\n    WHEN latest_consumed_at < now() - interval '15 minutes' THEN 'stale_gt_15m'\n    ELSE 'fresh'\n  END AS ingest_status\nFROM latest\nWHERE latest_consumed_at < now() - interval '15 minutes'\nORDER BY consumed_age_sec DESC, meter_urn, measurement\nLIMIT 100;"
