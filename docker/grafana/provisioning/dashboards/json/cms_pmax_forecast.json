{
  "uid": "cms-pmax-forecast",
  "title": "CMS P-Max Forecast",
  "tags": [
    "cms",
    "pmax",
    "forecast",
    "mart"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "P-Max forecast rows",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS forecast_rows FROM mart.pmax_forecast_15min;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Latest P-Max forecast created age",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT EXTRACT(EPOCH FROM now() - max(created_at)) AS latest_created_age_sec FROM mart.pmax_forecast_15min;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Latest P-Max run status",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT run_id, status, quality_status, logical_meter_count, forecast_row_count, error_reason, completed_at FROM ops.pmax_forecast_inference_log ORDER BY completed_at DESC NULLS LAST, started_at DESC LIMIT 10;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "P-Max forecast rows by logical meter",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT logical_meter, source_meter_urn, count(*) AS rows, min(base_ts) AS first_base_ts, max(base_ts) AS latest_base_ts, max(created_at) AS latest_created_at FROM mart.pmax_forecast_15min GROUP BY logical_meter, source_meter_urn ORDER BY logical_meter, source_meter_urn;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "P-Max latest forecast detail",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT logical_meter, source_meter_urn, base_ts, input_end_ts, target_ts, actual_window_ts, horizon_minutes, predicted_p_max FROM mart.pmax_forecast_15min ORDER BY created_at DESC, logical_meter, horizon_minutes LIMIT 100;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "P-Max evaluation error",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT logical_meter, horizon_minutes, count(*) AS evaluation_rows, avg(absolute_error) AS avg_absolute_error, sqrt(avg(squared_error)) AS rmse, max(evaluated_at) AS latest_evaluated_at FROM qa.pmax_forecast_evaluation GROUP BY logical_meter, horizon_minutes ORDER BY logical_meter, horizon_minutes;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
