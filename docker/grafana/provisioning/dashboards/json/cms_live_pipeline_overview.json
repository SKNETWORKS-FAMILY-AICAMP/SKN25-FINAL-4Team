    {
      "id": 16,
      "type": "table",
      "title": "Meter collection by series",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  meter_urn,\n  measurement,\n  count(*) AS events_in_range,\n  max(event_ts) AS latest_event_ts,\n  max(received_at) AS latest_received_at,\n  EXTRACT(EPOCH FROM now() - max(event_ts)) AS event_age_sec,\n  count(*) FILTER (WHERE policy_lookup_status = 'resolved') AS resolved_events,\n  count(*) FILTER (WHERE policy_lookup_status <> 'resolved') AS unresolved_events\nFROM live.measurement_event\nWHERE event_ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY meter_urn, measurement\nORDER BY latest_event_ts DESC, events_in_range DESC, meter_urn, measurement\nLIMIT 200;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
