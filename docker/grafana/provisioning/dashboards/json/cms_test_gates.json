    {
      "id": 6,
      "type": "bargauge",
      "title": "Processed / inserted / duplicate / retry / DLQ invariant",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "postgres",
        "uid": "postgres-cms-live"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (SELECT run_id FROM ops.pipeline_metric WHERE stage LIKE 'live_soak_%' OR stage LIKE 't4%' GROUP BY run_id ORDER BY max(metric_ts) DESC LIMIT 1), pivot AS (SELECT metric_name, max(metric_value) AS value FROM ops.pipeline_metric WHERE run_id IN (SELECT run_id FROM latest) GROUP BY metric_name) SELECT COALESCE((SELECT value FROM pivot WHERE metric_name='consumer_processed'),0) AS processed, COALESCE((SELECT value FROM pivot WHERE metric_name='consumer_inserted'),0) AS inserted, COALESCE((SELECT value FROM pivot WHERE metric_name='consumer_duplicate'),0) AS duplicate, COALESCE((SELECT value FROM pivot WHERE metric_name='consumer_retry'),0) AS retry, COALESCE((SELECT value FROM pivot WHERE metric_name='consumer_dlq'),0) AS dlq, COALESCE((SELECT value FROM pivot WHERE metric_name IN ('consumer_lag_after','lag_after')),0) AS lag_after, COALESCE((SELECT value FROM pivot WHERE metric_name='consumer_processed'),0) - COALESCE((SELECT value FROM pivot WHERE metric_name='consumer_inserted'),0) - COALESCE((SELECT value FROM pivot WHERE metric_name='consumer_duplicate'),0) - COALESCE((SELECT value FROM pivot WHERE metric_name='consumer_dlq'),0) AS invariant_delta;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
