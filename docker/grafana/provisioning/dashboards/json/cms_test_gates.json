      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH recent AS (SELECT run_id, max(metric_ts) AS latest_ts FROM ops.pipeline_metric WHERE stage LIKE 'live_soak_%' OR stage LIKE 't4%' GROUP BY run_id ORDER BY latest_ts DESC LIMIT 10) SELECT r.latest_ts, m.run_id, max(m.stage) AS stage, max(m.metric_value) FILTER (WHERE m.metric_name IN ('producer_accepted','producer_emitted')) AS producer_events, max(m.metric_value) FILTER (WHERE m.metric_name='consumer_processed') AS processed, max(m.metric_value) FILTER (WHERE m.metric_name='consumer_inserted') AS inserted, max(m.metric_value) FILTER (WHERE m.metric_name='consumer_duplicate') AS duplicate, max(m.metric_value) FILTER (WHERE m.metric_name='consumer_retry') AS retry, max(m.metric_value) FILTER (WHERE m.metric_name='consumer_dlq') AS dlq, max(m.metric_value) FILTER (WHERE m.metric_name IN ('consumer_lag_after','lag_after')) AS lag_after FROM recent r JOIN ops.pipeline_metric m USING (run_id) GROUP BY r.latest_ts, m.run_id ORDER BY r.latest_ts DESC;"
        }
      ],
