        "valueMode": "color"
      },
      "pluginVersion": "11.5.2",
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH latest AS (SELECT run_id FROM ops.pipeline_metric WHERE stage LIKE 'live_soak_%' OR stage LIKE 't4%' GROUP BY run_id ORDER BY max(metric_ts) DESC LIMIT 1), pivot AS (SELECT metric_name, max(metric_value) AS value FROM ops.pipeline_metric WHERE run_id IN (SELECT run_id FROM latest) AND metric_name IN ('consumer_duplicate','consumer_reprocessed') GROUP BY metric_name) SELECT 'consumer_duplicate' AS metric, COALESCE((SELECT value FROM pivot WHERE metric_name='consumer_duplicate'),0) AS value UNION ALL SELECT 'consumer_reprocessed' AS metric, COALESCE((SELECT value FROM pivot WHERE metric_name='consumer_reprocessed'),0) AS value"
        }
