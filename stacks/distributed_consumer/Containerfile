FROM python:3.12-slim

LABEL org.opencontainers.image.title="cms-consumer-runtime" \
      org.opencontainers.image.description="CMS Kafka to PostgreSQL consumer-only runtime" \
      org.opencontainers.image.source="SKN25-FINAL-4Team" \
      cms.runtime.roles="consumer,stream-db-writer"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/workspace/src

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --upgrade pip \
    && python -m pip install 'psycopg[binary]>=3.2,<4' 'confluent-kafka>=2.6,<3'

WORKDIR /workspace

COPY src /workspace/src
COPY scripts/stream /workspace/scripts/stream

CMD ["python", "scripts/stream/consumer_service.py", "--dry-run"]
