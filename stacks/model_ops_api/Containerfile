FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/workspace:/workspace/src

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid 1000 --home-dir /workspace --shell /usr/sbin/nologin appuser

COPY stacks/stream_runtime/requirements.txt /tmp/requirements.phase1.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/requirements.phase1.txt

COPY src /workspace/src
COPY scripts /workspace/scripts

RUN mkdir -p /workspace/artifacts \
    && chown -R appuser:appuser /workspace

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import sys, urllib.request; r = urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4); sys.exit(0 if r.status == 200 else 1)"

USER appuser

CMD ["python", "-m", "uvicorn", "cms.service.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
