      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-cms-live"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH meter_registry(meter_urn, meter_domain, meter_role, equipment_group, equipment_name, building_code, anomaly_priority) AS (\n  VALUES\n    ('V.Z82','electricity','consumption','grid_transformer','','V',1),\n    ('V.Z81','electricity','consumption','grid_transformer','','V',1),\n    ('H2.Z35','electricity','consumption','grid_transformer','','H2',1),\n    ('H2.Z351','electricity','consumption','grid_transformer','','H2',1),\n    ('H2.Z36','electricity','consumption','grid_transformer','','H2',1),\n    ('H2.Z361','electricity','consumption','grid_transformer','','H2',1),\n    ('H1.Z20','electricity','production','chp','','H1',1),\n    ('H1.ZE20','electricity','production','chp','','H1',1),\n    ('V.Z84','electricity','production','pv','','V',2),\n    ('V.ZE84','electricity','production','pv','','V',2),\n    ('H1.Z310','electricity','production','pv','','H1',2),\n    ('H2.Z311','electricity','production','pv','','H2',2),\n    ('H3.Z312','electricity','production','pv','','H3',2),\n    ('H1.Z15','electricity','consumption','emission_lab','','H1',3),\n    ('H1.Z28','electricity','consumption','emission_lab','','H1',3),\n    ('H1.Z17','electricity','consumption','emission_lab','','H1',3),\n    ('H1.Z29','electricity','consumption','emission_lab','','H1',3),\n    ('H1.Z10','electricity','consumption','emission_lab','','H1',3),\n    ('H1.Z13','electricity','consumption','emission_lab','','H1',3),\n    ('H1.Z14','electricity','consumption','emission_lab','','H1',3),\n    ('H1.Z19','electricity','consumption','emission_lab','','H1',3),\n    ('H1.Z23','electricity','consumption','emission_lab','','H1',3),\n    ('H1.Z18','electricity','consumption','emission_lab','','H1',3),\n    ('H1.Z21','electricity','consumption','emission_lab','','H1',3),\n    ('H1.Z22','electricity','consumption','emission_lab','','H1',3),\n    ('H1.Z26','electricity','consumption','emission_lab','','H1',3),\n    ('H1.Z27','electricity','consumption','emission_lab','','H1',3),\n    ('H1.Z16','electricity','consumption','central_cooling','','H1',1),\n    ('H1.Z11','electricity','consumption','central_cooling','','H1',1),\n    ('H1.Z12','electricity','consumption','central_cooling','','H1',1),\n    ('H1.Z24','electricity','consumption','central_cooling','','H1',1),\n    ('H1.Z25','electricity','consumption','central_cooling','','H1',1),\n    ('H3.Z43','electricity','consumption','server_power','','H3',2),\n    ('H3.ZE43','electricity','consumption','server_power','','H3',2),\n    ('H3.Z44','electricity','consumption','server_power','','H3',2),\n    ('H3.ZE44','electricity','consumption','server_power','','H3',2),\n    ('H3.Z46','electricity','consumption','server_power','','H3',2),\n    ('H2.Z61','electricity','consumption','server_power','','H2',2),\n    ('H2.Z62','electricity','consumption','server_power','','H2',2),\n    ('H2.Z63','electricity','consumption','server_power','','H2',2),\n    ('H2.Z64','electricity','consumption','server_power','','H2',2),\n    ('H2.ZE64','electricity','consumption','server_power','','H2',2),\n    ('H2.Z65','electricity','consumption','server_power','','H2',2),\n    ('H2.ZE65','electricity','consumption','server_power','','H2',2),\n    ('H3.Z71','electricity','consumption','server_power','','H3',2),\n    ('H3.Z45','electricity','consumption','local_cooling','','H3',2),\n    ('H2.Z66','electricity','consumption','local_cooling','','H2',2),\n    ('H2.ZE66','electricity','consumption','local_cooling','','H2',2),\n    ('H2.Z67','electricity','consumption','local_cooling','','H2',2),\n    ('H2.ZE67','electricity','consumption','local_cooling','','H2',2),\n    ('H2.T.Z31','electricity','consumption','ventilation','','H2',3),\n    ('H3.Z42','electricity','consumption','ventilation','','H3',3),\n    ('H2.Z68','electricity','consumption','ventilation','','H2',3),\n    ('H2.Z69','electricity','consumption','ventilation','','H2',3),\n    ('H2.Z70','electricity','consumption','ventilation','','H2',3),\n    ('H2.T.Z34','electricity','consumption','workshop_test','','H2',3),\n    ('H2.ZE74','electricity','consumption','workshop_test','','H2',3),\n    ('H2.T.Z30','electricity','consumption','office_distribution','','H2',3),\n    ('H2.T.Z32','electricity','consumption','office_distribution','','H2',3),\n    ('H4.Z50','electricity','consumption','office_distribution','','H4',3),\n    ('H4.ZE50','electricity','consumption','office_distribution','','H4',3),\n    ('H4.Z51','electricity','consumption','office_distribution','','H4',3),\n    ('H4.ZE51','electricity','consumption','office_distribution','','H4',3),\n    ('H2.T.Z33','electricity','consumption','design_studio_distribution','','H2',3),\n    ('H3.Z40','electricity','consumption','design_studio_distribution','','H3',3),\n    ('H3.ZE40','electricity','consumption','design_studio_distribution','','H3',3),\n    ('H3.Z41','electricity','consumption','design_studio_distribution','','H3',3),\n    ('H3.ZE41','electricity','consumption','design_studio_distribution','','H3',3),\n    ('H3.Z47','electricity','consumption','design_studio_distribution','','H3',3),\n    ('H3.Z48','electricity','consumption','design_studio_distribution','','H3',3),\n    ('H3.Z49','electricity','consumption','design_studio_distribution','','H3',3),\n    ('V.K21','thermal','thermal_flow','cooling_thermal','','V',1),\n    ('H1.K11','thermal','thermal_flow','hvac_thermal','','H1',2),\n    ('H1.K12','thermal','thermal_flow','hvac_thermal','','H1',2),\n    ('H1.K14','thermal','thermal_flow','hvac_thermal','','H1',2),\n    ('H1.K15','thermal','thermal_flow','hvac_thermal','','H1',2),\n    ('H2.K21','thermal','thermal_flow','hvac_thermal','','H2',2),\n    ('H1.K16','thermal','thermal_flow','server_thermal','','H1',2),\n    ('H1.W11','thermal','thermal_flow','heat_generation','','H1',2),\n    ('H1.W12','thermal','thermal_flow','chp_heat_generation','','H1',2),\n    ('WeatherStation.Weather','weather','weather','weather_station','','WeatherStation',4)\n),\nlatest AS (\n  SELECT r.meter_urn,r.meter_domain,r.meter_role,r.equipment_group,r.equipment_name,r.building_code,r.anomaly_priority,\n    count(e.*) FILTER (WHERE e.consumed_at >= now() - interval '15 minutes') AS events_15m,\n    count(e.*) FILTER (WHERE e.consumed_at >= now() - interval '1 hour') AS events_1h,\n    max(e.event_ts) AS latest_event_ts,\n    max(e.consumed_at) AS latest_consumed_at,\n    EXTRACT(EPOCH FROM now() - max(e.consumed_at)) AS consumed_age_sec,\n    EXTRACT(EPOCH FROM max(e.consumed_at) - max(e.event_ts)) AS latest_source_to_consume_sec,\n    COALESCE(max(e.policy_lookup_status), 'no_recent_event') AS policy_lookup_status,\n    (max(e.consumed_at) IS NULL OR EXTRACT(EPOCH FROM now() - max(e.consumed_at)) > 900) AS stale_gt_15m\n  FROM meter_registry r\n  LEFT JOIN live.measurement_event e ON e.meter_urn = r.meter_urn AND e.consumed_at >= now() - interval '24 hours'\n  GROUP BY r.meter_urn,r.meter_domain,r.meter_role,r.equipment_group,r.equipment_name,r.building_code,r.anomaly_priority\n) SELECT count(*) AS critical_stale_meters FROM latest WHERE anomaly_priority <= 2 AND stale_gt_15m;"
        }
      ],
